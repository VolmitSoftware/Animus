{
  "schemaVersion": 1,
  "features": [
    {
      "id": "animus.definitions.commands",
      "scenario": "animus-definitions",
      "match": {
        "animus.phase": "prepare"
      }
    },
    {
      "id": "animus.definitions.restart",
      "scenario": "animus-definitions",
      "match": {
        "animus.phase": "verify"
      }
    },
    {
      "id": "animus.native-packet-proof",
      "unsupported": "Native-codec client reports are separate from this Mineflayer coverage matrix; see managed native result.json evidence."
    },
    {
      "id": "animus.folia-packet-proof",
      "unsupported": "Folia packet proof is deliberately disabled pending region-safe snapshots."
    },
    {
      "id": "animus.client-visual-fidelity",
      "unsupported": "Neither Mineflayer nor native wire assertions establish graphical fidelity."
    },
    {
      "id": "animus.persisted-runtime",
      "unsupported": "External exact-codec production reports are separate from this Mineflayer matrix; inspect artifact-specific production results."
    },
    {
      "id": "animus.manual-combat",
      "unsupported": "External native-codec combat scenarios have independent receipts; full Sentinel behavior remains incomplete."
    }
  ],
  "scope": "Mechanical proof, persisted virtual NPC lifecycle and initial manual combat; no parity or performance claim",
  "buildTargets": [
    "animus:core",
    "animus:bukkit",
    "animus:converter",
    "animus:bukkit-api-26.1.2",
    "animus:bukkit-api-26.2",
    "animus:bukkit-api-26.3"
  ],
  "serverTargets": [
    {
      "platform": "paper",
      "minecraftVersion": "26.1.2",
      "channel": "STABLE",
