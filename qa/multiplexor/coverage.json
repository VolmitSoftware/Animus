  ],
  "scenarios": [
    {
      "source": "qa/multiplexor/managed-runtime.py",
      "runner": "Multiplexor projects deploy + runtime console",
      "checks": [
        "exact-version startup",
        "explicit capability status",
        "JSON persistence across restart",
        "validation",
        "deletion",
        "clean managed shutdown"
      ]
    },
    {
      "source": "qa/multiplexor/definitions.mjs",
      "runner": "Multiplexor gameplay run",
      "phases": [
        "prepare",
        "verify"
      ],
      "requires": "Mineflayer codec support; currently 26.1.2 only"
    },
    {
      "source": "qa/packet-client.mjs",
      "runner": "external native-codec client attached to Multiplexor-managed server",
      "requires": "exact matching native Minecraft codec jars",
      "checks": [
        "packet bodies",
        "movement",
        "attack/use",
        "signed skins",
        "reach and visibility authority",
        "cleanup",
        "viewer isolation"
      ]
    },
    {
      "source": "qa/multiplexor/runtime-npcs.py",
      "runner": "Multiplexor artifact deploy/start/restart/stop with external exact-codec clients",
      "clients": [
        "qa/runtime-client.mjs",
        "qa/combat-client.mjs"
      ],
      "checks": [
        "persisted activation",
        "shared identity and separate viewer IDs",
        "signed skin restart",
        "delivered chunk visibility",
        "preview and production coexistence",
        "production interaction authority",
        "dimension changes and reconnect",
        "invalid edit retention",
        "manual real damage cancellation",
        "ordinary-zombie pursuit",
        "native goals and route restoration",
        "closed-bridge rejection and mob reacquisition",
        "review gate",
        "cleanup"
      ]
    }
  ],
  "limitations": [
    "Folia packet proof is intentionally disabled pending region-safe world snapshots.",
    "Fabric, Forge and NeoForge remain deferred.",
    "Protocol assertions do not prove visual rendering quality.",
    "Every scenario must match its recorded artifact; earlier proof results cannot certify a later runtime build."
  ]
}
