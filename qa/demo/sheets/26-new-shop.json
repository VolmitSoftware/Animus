{
  "id": "26-new-shop",
  "title": "New shop",
  "description": "Making the plaza:stall shop on the trader and stocking it with bread",
  "target": 46,
  "stage": {
    "world": "town",
    "console": [
      "animus create greeter name=Greeter world=world x=-2.5 y=64 z=-9.5",
      "animus create trader type=minecraft:llama name=Trader world=world x=4.5 y=64 z=-9.5"
    ]
  },
  "setup": [
    {"run": "/gamemode creative"},
    {"run": "/clear @s"},
    {"hotbar": 0},
    {"run": "/animus tools wand"},
    {"wait": 700},
    {"run": "/item replace entity @s hotbar.1 with bread 16"},
    {"tp": [-14, 64, 8, -90, 5]},
    {"wait": 600},
    {"clearChat": true},
    {"wait": 3500}
  ],
  "beats": [
    {"perspective": "third-front"},
    {"wait": 2200, "note": "the owner's skin"},
    {"perspective": "first"},
    {"wait": 300},
    {"tp": [4.5, 64, -6.5, 180, 6]},
    {"wait": 400},
    {"lookAtEntity": "Llama", "ms": 500},
    {"useItem": true},
    {"screen": "Trader"},
    {"click": "Shop"},
    {"screen": "Shops"},
    {"result": "Shops lists the Bakery, on no selected NPC", "ms": 1500},
    {"hover": "New shop", "ms": 1200},
    {"click": "New shop"},
    {"screen": "Anvil"},
    {"anvil": "plaza:stall"},
    {"wait": 900},
    {"result": "the new shop's details, already on the trader; chat names shops/plaza/stall.json", "ms": 1800},
    {"closeScreen": true},
    {"hotbar": 1, "note": "a stack of bread"},
    {"wait": 300},
    {"type": "/animus tools", "note": "the trader is selected, so its screen opens"},
    {"screen": "Trader"},
    {"click": "Shop"},
    {"screen": "Shops"},
    {"hover": "stall", "ms": 1300},
    {"click": "stall", "button": "right"},
    {"wait": 600},
    {"hover": "Add held item", "ms": 1500},
    {"click": "Add held item"},
    {"screen": "Anvil"},
    {"anvil": "5"},
    {"wait": 900},
    {"hover": "Offers", "ms": 1500, "note": "1 offer"},
    {"click": "Offers"},
    {"screen": "Offers"},
    {"hover": "Bread", "ms": 1800, "note": "Players buy it for 5"},
    {"closeScreen": true},
    {"result": "chat: the bread offer was added to plaza:stall", "ms": 2000}
  ],
  "closing": "New shop made plaza:stall on the trader; Add held item sells the bread for 5"
}
