{
  "id": "21-riding",
  "title": "Riding",
  "description": "Turning on riding for the trader, raising its speed and riding it",
  "target": 42,
  "stage": {
    "world": "town",
    "console": [
      "animus despawn town/guard",
      "animus create trader type=minecraft:llama name=Trader world=world x=16.5 y=64 z=0.5",
      "animus edit trader {\"position\":{\"world\":\"world\",\"x\":16.5,\"y\":64,\"z\":0.5,\"yaw\":-90,\"pitch\":0}}",
      "animus despawn trader",
      "animus spawn trader"
    ]
  },
  "setup": [
    {"run": "/gamemode creative"},
    {"run": "/clear @s"},
    {"hotbar": 0},
    {"run": "/animus tools wand"},
    {"run": "/animus tools mode advanced", "note": "Mounts and riding is in Advanced"},
    {"wait": 700},
    {"tp": [9.5, 64, 0.5, -90, 8], "note": "far enough back that the front camera stays clear of the trader"},
    {"wait": 11000},
    {"clearChat": true}
  ],
  "beats": [
    {"perspective": "third-front"},
    {"wait": 2200, "note": "the owner's skin"},
    {"perspective": "first"},
    {"tp": [13.5, 64, 0.5, -90, 8]},
    {"wait": 400},
    {"lookAtEntity": "Llama", "ms": 500},
    {"useItem": true},
    {"screen": "Trader"},
    {"click": "Movement"},
    {"screen": "Movement"},
    {"click": "Mounts and riding"},
    {"screen": "Mounts"},
    {"click": "Riding"},
    {"wait": 600},
    {"result": "Riding: Enabled, Permission, Speed, Leash and Lifetime", "ms": 1500},
    {"hover": "Enabled", "ms": 1200},
    {"click": "Enabled"},
    {"wait": 400},
    {"click": "Speed"},
    {"wait": 400},
    {"click": "Speed"},
    {"wait": 400},
    {"hover": "Speed", "ms": 1300},
    {"click": "Save"},
    {"wait": 500},
    {"result": "the changes are saved; chat has them with [Undo]", "ms": 1500},
    {"closeScreen": true},
    {"hotbar": 8, "note": "an empty hand, as any player"},
    {"wait": 300},
    {"lookAtEntity": "Llama", "ms": 500},
    {"wait": 200},
    {"useItem": true},
    {"wait": 600},
    {"result": "you sit on the trader; the line above the hotbar says how to get off", "ms": 1500},
    {"perspective": "third-back"},
    {"look": {"yaw": -90, "pitch": 6, "ms": 400}, "note": "east, along the open road"},
    {"wait": 300},
    {"move": "forward", "ms": 1800},
    {"wait": 300},
    {"type": "/animus ride status"},
    {"result": "chat: one rider, you on the trader", "ms": 1800},
    {"key": "sneak", "hold": 400},
    {"wait": 600},
    {"result": "you are off again, the trader beside you on the road", "ms": 1600}
  ],
  "closing": "Riding is on for the trader at a higher speed; sneak gets you off"
}
