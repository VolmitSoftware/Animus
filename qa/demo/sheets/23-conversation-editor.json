{
  "id": "23-conversation-editor",
  "title": "Conversation editor",
  "description": "Writing the greeter's conversation with one question in the block editor",
  "target": 56,
  "stage": {
    "world": "town",
    "console": [
      "animus create greeter name=Greeter world=world x=-2.5 y=64 z=-9.5",
      "animus create trader type=minecraft:llama name=Trader world=world x=4.5 y=64 z=-9.5"
    ]
  },
  "setup": [
    {"run": "/gamemode creative"},
    {"run": "/clear @s"},
    {"hotbar": 0},
    {"run": "/animus tools wand"},
    {"wait": 700},
    {"tp": [-14, 64, 8, -90, 5]},
    {"wait": 600},
    {"clearChat": true},
    {"wait": 3500}
  ],
  "beats": [
    {"perspective": "third-front"},
    {"wait": 2200, "note": "the owner's skin"},
    {"perspective": "first"},
    {"wait": 300},
    {"tp": [-2.5, 64, -6, 180, 4]},
    {"wait": 400},
    {"lookAtEntity": "Greeter", "ms": 500},
    {"useItem": true},
    {"screen": "Greeter"},
    {"hover": "Talk", "ms": 1200},
    {"click": "Talk"},
    {"screen": "Talk"},
    {"result": "the conversation is made, put on the greeter and opened on its first block", "ms": 1500},
    {"hoverSlot": 9, "ms": 1500, "note": "Line 1: Hello"},
    {"clickSlot": 9},
    {"screen": "Anvil"},
    {"anvil": "Welcome to the plaza, {player_name}."},
    {"screen": "Talk"},
    {"hoverSlot": 9, "ms": 1800, "note": "the line now reads the welcome"},
    {"click": "Add choice"},
    {"screen": "Anvil"},
    {"anvil": "Where is the bakery?"},
    {"wait": 600},
    {"screen": "Anvil", "note": "then what the NPC says back"},
    {"anvil": "Follow the lanterns north."},
    {"screen": "Talk"},
    {"wait": 300},
    {"hover": "Question", "ms": 1500, "note": "the block got a question, Choose one., to edit"},
    {"hover": "Where is the bakery", "ms": 1800, "note": "Then: Follow the lanterns north."},
    {"click": "Where is the bakery"},
    {"wait": 600},
    {"result": "the answer's own block, with the NPC's reply as its line", "ms": 1600},
    {"click": "Back"},
    {"wait": 500},
    {"hover": "Save", "ms": 1200},
    {"click": "Save"},
    {"wait": 800},
    {"closeScreen": true},
    {"result": "chat: the conversation is saved, with [Undo]", "ms": 2500}
  ],
  "closing": "Talk made the greeter's conversation: a welcome line, one question and its answer"
}
