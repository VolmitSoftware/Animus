{
  "id": "09-attributes",
  "title": "Attributes",
  "description": "Growing and shrinking the greeter with the scale attribute, then resetting it",
  "target": 44,
  "stage": {
    "world": "town",
    "console": [
      "animus create greeter name=Greeter world=world x=-2.5 y=64 z=-9.5",
      "animus create trader type=minecraft:llama name=Trader world=world x=4.5 y=64 z=-9.5"
    ]
  },
  "setup": [
    {"run": "/gamemode creative"},
    {"run": "/clear @s"},
    {"hotbar": 0},
    {"run": "/animus tools wand"},
    {"run": "/animus tools mode advanced", "note": "Attributes is in Advanced"},
    {"wait": 700},
    {"tp": [-14, 64, 8, -90, 5]},
    {"wait": 600},
    {"clearChat": true},
    {"wait": 3500}
  ],
  "beats": [
    {"perspective": "third-front"},
    {"wait": 2200, "note": "the owner's skin"},
    {"perspective": "first"},
    {"wait": 600},
    {"tp": [-2.5, 64, -6, 180, 4]},
    {"wait": 400},
    {"lookAtEntity": "Greeter", "ms": 500},
    {"useItem": true},
    {"screen": "Greeter"},
    {"hover": "Attributes", "ms": 1200},
    {"click": "Attributes"},
    {"screen": "Attributes"},
    {"result": "Attributes lists what a player body carries, the common ones first", "ms": 1500},
    {"hover": "Scale", "ms": 1400},
    {"click": "Scale"},
    {"wait": 400},
    {"click": "Scale"},
    {"wait": 400},
    {"click": "Scale"},
    {"wait": 500},
    {"closeScreen": true},
    {"wait": 300},
    {"result": "the greeter is taller, a step per click", "ms": 2000},
    {"lookAtEntity": "Greeter", "ms": 400},
    {"useItem": true},
    {"screen": "Greeter"},
    {"click": "Attributes"},
    {"screen": "Attributes"},
    {"click": "Scale", "sneak": true},
    {"screen": "Anvil"},
    {"anvil": "0.6"},
    {"screen": "Attributes"},
    {"closeScreen": true},
    {"wait": 300},
    {"result": "the greeter shrinks to 0.6", "ms": 2000},
    {"lookAtEntity": "Greeter", "ms": 400},
    {"useItem": true},
    {"screen": "Greeter"},
    {"click": "Attributes"},
    {"screen": "Attributes"},
    {"click": "Scale", "sneak": true},
    {"screen": "Anvil"},
    {"anvil": "", "note": "typing nothing goes back to the vanilla default"},
    {"screen": "Attributes"},
    {"closeScreen": true},
    {"wait": 300},
    {"result": "the greeter is back at its normal size", "ms": 2000}
  ],
  "closing": "Click grows the greeter, sneak-click types 0.6, and typing nothing resets it"
}
