{
  "id": "12-folders",
  "title": "Folders",
  "description": "Moving the greeter and trader between folders, making plaza and renaming it",
  "target": 42,
  "stage": {
    "world": "town",
    "console": [
      "animus create greeter name=Greeter world=world x=-2.5 y=64 z=-9.5",
      "animus create trader type=minecraft:llama name=Trader world=world x=4.5 y=64 z=-9.5"
    ]
  },
  "setup": [
    {"run": "/gamemode creative"},
    {"run": "/clear @s"},
    {"hotbar": 0},
    {"run": "/animus tools wand"},
    {"run": "/animus tools mode advanced", "note": "Folder is in Advanced"},
    {"wait": 700},
    {"tp": [-2.5, 64, -7, 180, 5]},
    {"wait": 500},
    {"lookAtEntity": "Greeter", "ms": 500},
    {"wait": 300},
    {"attackTarget": true},
    {"wait": 600},
    {"tp": [4.5, 64, -7, 180, 5]},
    {"wait": 500},
    {"lookAtEntity": "Llama", "ms": 500},
    {"wait": 300},
    {"attackTarget": true, "sneak": true, "note": "adds the trader"},
    {"wait": 600},
    {"tp": [-14, 64, 8, -90, 5]},
    {"wait": 600},
    {"clearChat": true},
    {"wait": 3500}
  ],
  "beats": [
    {"perspective": "third-front"},
    {"wait": 2200, "note": "the owner's skin"},
    {"perspective": "first"},
    {"wait": 600},
    {"tp": [1.0, 64, -4.0, 180, 5]},
    {"wait": 300},
    {"type": "/animus tools"},
    {"screen": "2 NPCs"},
    {"click": "Folder"},
    {"screen": "Folders"},
    {"result": "Folders lists Top level, spare and town with their NPC counts", "ms": 1500},
    {"hover": "spare", "ms": 1300},
    {"click": "spare"},
    {"wait": 600},
    {"result": "chat: the greeter and the trader moved to spare", "ms": 1500},
    {"hover": "New folder", "ms": 1000},
    {"click": "New folder"},
    {"screen": "Anvil"},
    {"anvil": "plaza"},
    {"screen": "Folders"},
    {"wait": 400},
    {"hover": "plaza", "ms": 1500},
    {"click": "plaza", "button": "right"},
    {"screen": "Folder plaza"},
    {"click": "Rename"},
    {"screen": "Anvil"},
    {"anvil": "plaza/north"},
    {"wait": 600},
    {"hoverSlot": 4, "ms": 1500, "note": "the folder now reads plaza / north"},
    {"closeScreen": true},
    {"result": "chat: renamed plaza to plaza / north and moved its 2 NPCs", "ms": 2300}
  ],
  "closing": "A click moves the selection into a folder; New folder made plaza, renamed plaza/north"
}
