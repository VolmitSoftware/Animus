{
  "id": "20-mounts",
  "title": "Mounts",
  "description": "Seating the greeter on the trader and dismounting it",
  "target": 40,
  "stage": {
    "world": "town",
    "console": [
      "animus despawn town/guard",
      "animus create greeter name=Greeter world=world x=16.5 y=64 z=1.5",
      "animus create trader type=minecraft:llama name=Trader world=world x=19.5 y=64 z=1.5"
    ]
  },
  "setup": [
    {"run": "/gamemode creative"},
    {"run": "/clear @s"},
    {"hotbar": 0},
    {"run": "/animus tools wand"},
    {"run": "/animus tools mode advanced", "note": "Mounts and riding is in Advanced"},
    {"wait": 700},
    {"tp": [-14, 64, 8, -90, 5]},
    {"wait": 11000},
    {"clearChat": true}
  ],
  "beats": [
    {"perspective": "third-front"},
    {"wait": 2200, "note": "the owner's skin"},
    {"perspective": "first"},
    {"tp": [18, 64, -1.5, 0, 8], "note": "on the east road, both NPCs ahead with nothing between"},
    {"wait": 600},
    {"lookAtEntity": "Greeter", "ms": 500},
    {"useItem": true},
    {"screen": "Greeter"},
    {"click": "Movement"},
    {"screen": "Movement"},
    {"hover": "Mounts and riding", "ms": 1200},
    {"click": "Mounts and riding"},
    {"screen": "Mounts"},
    {"hoverSlot": 4, "ms": 1500, "note": "what it rides and what rides it: nothing yet"},
    {"hover": "Ride another", "ms": 1300},
    {"click": "Ride another NPC"},
    {"wait": 600, "note": "the window closes; the line above the hotbar asks for an NPC"},
    {"lookAtEntity": "Llama", "ms": 500},
    {"wait": 300},
    {"useItem": true},
    {"wait": 500},
    {"move": "back", "ms": 400},
    {"wait": 300},
    {"result": "the greeter sits on the trader; chat has the change with [Undo]", "ms": 2500},
    {"type": "/animus tools", "note": "the greeter stays selected"},
    {"screen": "Greeter"},
    {"click": "Movement"},
    {"screen": "Movement"},
    {"click": "Mounts and riding"},
    {"screen": "Mounts"},
    {"hoverSlot": 4, "ms": 1500, "note": "rides Trader"},
    {"click": "Dismount"},
    {"wait": 300},
    {"click": "Click again"},
    {"wait": 500},
    {"closeScreen": true},
    {"wait": 400},
    {"result": "the greeter is off the trader and stands on its own again", "ms": 2500}
  ],
  "closing": "Ride another NPC seated the greeter on the trader; Dismount took it off"
}
