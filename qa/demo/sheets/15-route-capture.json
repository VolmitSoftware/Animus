{
  "id": "15-route-capture",
  "title": "Route capture",
  "description": "Walking a path and dropping four route points",
  "target": 40,
  "stage": {
    "world": "town",
    "console": [
      "animus navigation stop town/guard",
      "animus edit town/guard {\"modules\":{\"animus:navigation\":{\"enabled\":false}}}",
      "animus edit town/guard {\"position\":{\"world\":\"world\",\"x\":12.5,\"y\":64,\"z\":-9.5,\"yaw\":0,\"pitch\":0}}",
      "animus despawn town/guard",
      "animus spawn town/guard"
    ]
  },
  "setup": [
    {"run": "/gamemode creative"},
    {"tp": [14.5, 64, 0.5, -90, 12]},
    {"wait": 500},
    {"run": "/give @s minecraft:blaze_rod"},
    {"run": "/clear @s"},
    {"run": "/animus tools wand"},
    {"wait": 700},
    {"hotbar": 0},
    {"wait": 500},
    {"wait": 11000},
    {"clearChat": true}
  ],
  "beats": [
    {"perspective": "third-back"},
    {"wait": 1800},
    {"palette": true},
    {"click": "Routes"},
    {"result": "the Routes screen lists patrol and plaza-loop, with Capture a route below", "ms": 1500},
    {"hover": "Capture", "ms": 1500},
    {"click": "Capture a route"},
    {"result": "the window closes; the action bar reads Point 1 at 14 64 0", "ms": 1500},
    {"caption": "Sneak drops a point", "ms": 2200},
    {"move": "forward", "ms": 1400},
    {"wait": 300},
    {"key": "sneak", "hold": 250},
    {"wait": 300},
    {"move": "forward", "ms": 600},
    {"wait": 1300},
    {"move": "forward", "ms": 800},
    {"wait": 300},
    {"key": "sneak", "hold": 250},
    {"wait": 300},
    {"look": {"yaw": 180, "pitch": 12, "ms": 700}},
    {"move": "forward", "ms": 900},
    {"wait": 300},
    {"key": "sneak", "hold": 250},
    {"wait": 900},
    {"palette": true},
    {"click": "Routes"},
    {"wait": 600},
    {"click": "Capturing", "button": "right"},
    {"result": "Route points lists Point 1 to Point 4", "ms": 1500},
    {"hover": "Point 1", "ms": 1500},
    {"hover": "(here)", "ms": 1500},
    {"click": "Back"},
    {"wait": 500},
    {"click": "Save route"},
    {"wait": 400},
    {"closeScreen": true},
    {"wait": 500},
    {"result": "chat reads Saved wp-<your name>, 4 points", "ms": 2500}
  ],
  "closing": "Four points saved as a looping route, routes/wp-<your name>.json"
}
