{
  "id": "28-combat",
  "title": "Combat",
  "description": "Turning on combat for the guard, setting what it attacks and having it guard the player",
  "target": 58,
  "stage": {
    "world": "town",
    "console": [
      "animus navigation stop town/guard",
      "animus edit town/guard {\"modules\":{\"animus:navigation\":{\"enabled\":false}}}",
      "animus edit town/guard {\"position\":{\"world\":\"world\",\"x\":46.5,\"y\":64,\"z\":0.5,\"yaw\":90,\"pitch\":0}}",
      "animus despawn town/guard",
      "animus spawn town/guard"
    ]
  },
  "setup": [
    {"run": "/gamemode creative"},
    {"run": "/clear @s"},
    {"hotbar": 0},
    {"run": "/animus tools wand"},
    {"run": "/animus tools mode advanced", "note": "Targets is in Advanced"},
    {"wait": 700},
    {"run": "/gamemode survival", "note": "combat ignores players in creative"},
    {"tp": [-14, 64, 8, -90, 5]},
    {"wait": 600},
    {"clearChat": true},
    {"wait": 3500}
  ],
  "beats": [
    {"perspective": "third-front"},
    {"wait": 2200, "note": "the owner's skin"},
    {"perspective": "first"},
    {"tp": [44, 64, 0.5, -90, 5], "note": "2.5 blocks from the guard at the gate"},
    {"wait": 500},
    {"lookAtEntity": "Guard", "ms": 500},
    {"useItem": true},
    {"screen": "Guard"},
    {"click": "Combat"},
    {"screen": "Combat"},
    {"result": "Combat for the guard: Fights, Attacks, Can be hurt, Health, Guard me", "ms": 1500},
    {"hover": "Fights", "ms": 1000},
    {"click": "Fights"},
    {"wait": 500},
    {"hover": "Attacks", "ms": 1000},
    {"click": "Attacks"},
    {"wait": 500},
    {"hover": "Attacks", "ms": 1500, "note": "Monsters"},
    {"click": "Targets"},
    {"wait": 600},
    {"result": "the Targets rule list: one row per kind of rule", "ms": 1500},
    {"click": "Health below"},
    {"wait": 400},
    {"hover": "Health below", "ms": 1300, "note": "on at 50%"},
    {"click": "Save"},
    {"wait": 600},
    {"result": "chat shows the rules as the file reads them, with [Undo]", "ms": 1800},
    {"click": "Back"},
    {"screen": "Combat"},
    {"hover": "Guard me", "ms": 1000},
    {"click": "Guard me"},
    {"wait": 400},
    {"closeScreen": true},
    {"tp": [36.5, 64, 0.5, -90, 4], "note": "ten blocks west of the gate, facing it"},
    {"wait": 2800},
    {"result": "the guard leaves the gate and walks to the player", "ms": 2000},
    {"look": {"yaw": 90, "pitch": 4, "ms": 600}},
    {"move": "forward", "ms": 1500},
    {"wait": 300},
    {"look": {"yaw": -90, "pitch": 4, "ms": 700}, "note": "turn back to see it follow"},
    {"wait": 900},
    {"result": "the guard has followed and stands close by", "ms": 1800},
    {"type": "/animus tools", "note": "the guard is selected"},
    {"screen": "Guard"},
    {"click": "Combat"},
    {"screen": "Combat"},
    {"hover": "Guard me", "ms": 1200, "note": "Guard me: on"},
    {"click": "Guard me"},
    {"wait": 500},
    {"closeScreen": true},
    {"wait": 300},
    {"result": "the guard stops guarding and stays where it stopped", "ms": 2200}
  ],
  "closing": "The guard fights monsters, targets low health, and guards you until clicked again"
}
