{
  "id": "28-combat",
  "title": "Combat",
  "description": "Turning on combat, setting target rules and having the guard follow the player",
  "target": 49,
  "stage": {
    "world": "town",
    "console": [
      "animus navigation stop town/guard",
      "animus edit town/guard {\"modules\":{\"animus:navigation\":{\"enabled\":false}}}",
      "animus edit town/guard {\"position\":{\"world\":\"world\",\"x\":46.5,\"y\":64,\"z\":0.5,\"yaw\":90,\"pitch\":0}}",
      "animus despawn town/guard",
      "animus spawn town/guard"
    ]
  },
  "setup": [
    {"run": "/gamemode creative"},
    {"run": "/animus tools wand"},
    {"wait": 700},
    {"hotbar": 0},
    {"wait": 500},
    {"tp": [43.5, 64, 0.5, -90, 5]},
    {"wait": 500},
    {"lookAtEntity": "Guard", "ms": 500},
    {"wait": 300},
    {"attackTarget": true},
    {"wait": 600},
    {"hotbar": 8},
    {"run": "/gamemode survival"},
    {"tp": [-14, 64, 8, -90, 5]},
    {"perspective": "third-front"},
    {"wait": 600},
    {"clearChat": true},
    {"wait": 3500}
  ],
  "beats": [
    {"wait": 600},
    {"tp": [41.5, 64, -3.5, -90.3, 5]},
    {"perspective": "first"},
    {"wait": 300},
    {"palette": true},
    {"click": "Combat"},
    {"result": "the Combat screen for the guard, 1 selected", "ms": 1500},
    {"click": "Enable combat"},
    {"result": "chat: Combat on for guard, with [Undo]", "ms": 1500},
    {"click": "Targets"},
    {"result": "the Targets screen: one row per kind of target, all off", "ms": 1500},
    {"click": "Monsters"},
    {"wait": 400},
    {"hover": "Monsters", "ms": 1200},
    {"click": "Health below"},
    {"wait": 400},
    {"hover": "Health below", "ms": 1200},
    {"click": "Save"},
    {"result": "chat: Combat targets on guard, listing monsters and healthBelow 50", "ms": 1500},
    {"click": "Back"},
    {"result": "back on the Combat screen", "ms": 1500},
    {"click": "Guard me"},
    {"closeScreen": true},
    {"tp": [41.5, 64, 0.5, 90, 6]},
    {"perspective": "third-front"},
    {"look": {"yaw": 90, "pitch": 6, "ms": 500}},
    {"result": "the guard leaves its post and walks to the player", "ms": 2300},
    {"move": "forward", "ms": 1500},
    {"wait": 900},
    {"look": {"yaw": 150, "pitch": 6, "ms": 700}},
    {"wait": 2300},
    {"perspective": "first"},
    {"wait": 300},
    {"palette": true},
    {"click": "Combat"},
    {"result": "the Combat screen again", "ms": 1500},
    {"click": "Guard me", "button": "right"},
    {"result": "chat: the guard stopped guarding", "ms": 1500},
    {"click": "Status"},
    {"result": "chat: the guard is idle, no target", "ms": 1500},
    {"closeScreen": true},
    {"wait": 500},
    {"result": "the guard stays where it stopped", "ms": 2500}
  ],
  "closing": "Combat on, monsters targeted, and the guard follows until told to stop"
}
