{
  "id": "30-editor-pair-undo",
  "title": "Editor link and undo",
  "description": "Getting a pairing link from Home and undoing a rename from chat",
  "target": 36,
  "client": {"options": {"chatWidth": "0.6"}},
  "stage": {
    "world": "town",
    "console": [
      "animus create greeter name=Greeter world=world x=-2.5 y=64 z=-9.5",
      "animus create trader type=minecraft:llama name=Trader world=world x=4.5 y=64 z=-9.5"
    ]
  },
  "setup": [
    {"run": "/gamemode creative"},
    {"run": "/clear @s"},
    {"hotbar": 0},
    {"run": "/animus tools wand"},
    {"wait": 700},
    {"tp": [-14, 64, 8, -90, 5]},
    {"wait": 600},
    {"clearChat": true},
    {"wait": 3500}
  ],
  "beats": [
    {"perspective": "third-front"},
    {"wait": 2200, "note": "the owner's skin"},
    {"perspective": "first"},
    {"wait": 600},
    {"tp": [-2.5, 64, -6, 180, 4]},
    {"wait": 300},
    {"menu": true},
    {"hover": "Web editor", "ms": 1300},
    {"click": "Web editor"},
    {"wait": 800},
    {"result": "the window closes; chat has the pairing link with [Open editor] and [Copy]", "ms": 2000},
    {"hoverChat": "[Open editor]", "ms": 1500},
    {"closeScreen": true},
    {"lookAtEntity": "Greeter", "ms": 500},
    {"useItem": true},
    {"screen": "Greeter"},
    {"click": "Name"},
    {"screen": "Anvil"},
    {"anvil": "Town Greeter"},
    {"screen": "Town Greeter"},
    {"closeScreen": true},
    {"wait": 300},
    {"result": "the nameplate reads Town Greeter; the change's line in chat has [Undo]", "ms": 1800},
    {"hoverChat": "[Undo]", "ms": 1200},
    {"clickChat": "[Undo]"},
    {"wait": 500},
    {"closeScreen": true},
    {"wait": 300},
    {"result": "the old name, Greeter, is back", "ms": 2200}
  ],
  "closing": "Web editor sent the pairing link; one click on [Undo] took the new name back"
}
