{
  "id": "27-guis-holograms",
  "title": "GUIs and holograms",
  "description": "Adding a hologram line and a saved hologram to the greeter, then opening a chest GUI from the guard",
  "target": 72,
  "stage": {
    "world": "town",
    "console": [
      "animus navigation stop town/guard",
      "animus edit town/guard {\"modules\":{\"animus:navigation\":{\"enabled\":false}}}",
      "animus edit town/guard {\"position\":{\"world\":\"world\",\"x\":7.5,\"y\":64,\"z\":-11.5,\"yaw\":180,\"pitch\":0}}",
      "animus despawn town/guard",
      "animus spawn town/guard",
      "animus create greeter name=Greeter world=world x=3.5 y=64 z=-12.5",
      "animus gui create plaza:menu rows=3"
    ]
  },
  "setup": [
    {"run": "/gamemode creative"},
    {"run": "/clear @s"},
    {"hotbar": 0},
    {"run": "/animus tools wand"},
    {"run": "/animus tools mode advanced", "note": "GUIs is in Advanced"},
    {"tp": [60.5, 64, 40.5, 0, 0], "note": "far out of every shot: the hologram file keeps the spot it was made at"},
    {"wait": 500},
    {"run": "/animus hologram create plaza:sign text=\"Welcome to the plaza\"", "note": "a player command: it saves where you stand"},
    {"wait": 500},
    {"wait": 700},
    {"tp": [-14, 64, 8, -90, 5]},
    {"wait": 600},
    {"clearChat": true},
    {"wait": 3500}
  ],
  "beats": [
    {"perspective": "third-front"},
    {"wait": 2200, "note": "the owner's skin"},
    {"perspective": "first"},
    {"tp": [4.5, 64, -9, 165, 4], "note": "the greeter ahead, the guard to the right"},
    {"wait": 500},
    {"lookAtEntity": "Greeter", "ms": 500},
    {"useItem": true},
    {"screen": "Greeter"},
    {"click": "Hologram"},
    {"screen": "Hologram"},
    {"click": "Add line"},
    {"screen": "Anvil"},
    {"anvil": "&6Town greeter"},
    {"screen": "Hologram"},
    {"click": "Saved hologram"},
    {"screen": "Saved holograms"},
    {"hover": "plaza:sign", "ms": 1200},
    {"click": "plaza:sign"},
    {"wait": 600},
    {"screen": "Hologram"},
    {"hover": "Height", "ms": 1200},
    {"click": "Height"},
    {"wait": 300},
    {"click": "Height"},
    {"wait": 300},
    {"click": "Height"},
    {"wait": 400},
    {"closeScreen": true},
    {"lookAt": {"x": 3.5, "y": 66.5, "z": -12.5, "ms": 600}},
    {"result": "Town greeter in gold above the greeter, the plaza sign raised over it", "ms": 2200},
    {"lookAtEntity": "Greeter", "ms": 400},
    {"useItem": true},
    {"screen": "Greeter"},
    {"click": "Hologram"},
    {"screen": "Hologram"},
    {"click": "Height", "sneak": true},
    {"screen": "Anvil"},
    {"anvil": "", "note": "typing nothing puts it back above the head"},
    {"screen": "Hologram"},
    {"closeScreen": true},
    {"lookAt": {"x": 3.5, "y": 66.5, "z": -12.5, "ms": 600}},
    {"result": "the plaza sign sits right above the head again", "ms": 1800},
    {"lookAtEntity": "Guard", "ms": 500},
    {"useItem": true},
    {"screen": "Guard"},
    {"click": "GUIs"},
    {"screen": "Chest GUIs"},
    {"hover": "plaza:menu", "ms": 1200},
    {"click": "plaza:menu", "button": "right"},
    {"screen": "plaza:menu"},
    {"click": "Show to me"},
    {"wait": 900},
    {"result": "plaza:menu opens for you, an empty three-row chest", "ms": 1600},
    {"closeScreen": true},
    {"wait": 300},
    {"type": "/animus tools", "note": "the guard is selected"},
    {"screen": "Guard"},
    {"click": "GUIs"},
    {"screen": "Chest GUIs"},
    {"click": "plaza:menu"},
    {"wait": 500},
    {"closeScreen": true},
    {"hotbar": 8, "note": "an empty hand, as any player"},
    {"wait": 300},
    {"lookAtEntity": "Guard", "ms": 400},
    {"useItem": true},
    {"wait": 900},
    {"result": "a right-click on the guard opens plaza:menu", "ms": 2000},
    {"closeScreen": true},
    {"wait": 400}
  ],
  "closing": "The greeter shows its line and plaza:sign; the guard opens plaza:menu"
}
