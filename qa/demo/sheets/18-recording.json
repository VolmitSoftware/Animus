{
  "id": "18-recording",
  "title": "Recording and preview",
  "description": "Recording a short performance for the greeter and previewing it as a ghost",
  "target": 58,
  "stage": {
    "world": "town",
    "console": [
      "animus create greeter name=Greeter world=world x=-2.5 y=64 z=-9.5",
      "animus create trader type=minecraft:llama name=Trader world=world x=4.5 y=64 z=-9.5",
      "animus despawn town/cart"
    ]
  },
  "setup": [
    {"run": "/gamemode creative"},
    {"run": "/clear @s"},
    {"hotbar": 0},
    {"run": "/animus tools wand"},
    {"wait": 700},
    {"tp": [-2.5, 64, -3.6, 180, 8], "note": "far enough back that the front camera stays clear of the greeter"},
    {"wait": 11000},
    {"clearChat": true}
  ],
  "beats": [
    {"perspective": "third-front"},
    {"wait": 2200, "note": "the owner's skin"},
    {"perspective": "first"},
    {"tp": [-2.5, 64, -7, 180, 8]},
    {"wait": 400},
    {"lookAtEntity": "Greeter", "ms": 500},
    {"useItem": true},
    {"screen": "Greeter"},
    {"click": "Movement"},
    {"screen": "Movement"},
    {"click": "Recording"},
    {"screen": "Recordings"},
    {"result": "Recordings is empty, with New recording below", "ms": 1500},
    {"hoverSlot": 36, "ms": 1300},
    {"clickSlot": 36, "note": "New recording; by name it would hit the empty list's notice"},
    {"screen": "Anvil"},
    {"anvil": "wave-dance"},
    {"perspective": "third-back"},
    {"look": {"yaw": -90, "pitch": 8, "ms": 600}, "note": "turned east, into the open, during the countdown"},
    {"wait": 2800, "note": "the rest of the three second countdown above the hotbar"},
    {"key": "jump", "hold": 200},
    {"wait": 600},
    {"move": "forward", "ms": 800},
    {"wait": 200},
    {"key": "jump", "hold": 200},
    {"wait": 500},
    {"key": "sneak", "hold": 400},
    {"wait": 300},
    {"look": {"yaw": -60, "pitch": -4, "ms": 400}},
    {"key": "attack", "hold": 150},
    {"wait": 350},
    {"key": "attack", "hold": 150},
    {"wait": 300},
    {"move": "forward", "ms": 500},
    {"wait": 300},
    {"perspective": "first"},
    {"clickChat": "[Stop and save]"},
    {"screen": "Movement"},
    {"hoverSlot": 4, "ms": 1800, "note": "Now: replays recording Wave dance"},
    {"closeScreen": true},
    {"tp": [-8.5, 64, -3.5, -106, 10], "note": "west of where the recording started, facing along it, clear of the lamp posts"},
    {"wait": 1500},
    {"type": "/animus tools"},
    {"screen": "Greeter"},
    {"click": "Movement"},
    {"screen": "Movement"},
    {"click": "Recording"},
    {"screen": "Recordings"},
    {"hover": "Wave dance", "ms": 1300},
    {"click": "Wave dance", "button": "right"},
    {"screen": "Recording Wave dance"},
    {"hover": "Preview", "ms": 1300},
    {"click": "Preview"},
    {"wait": 4500},
    {"result": "a ghost only you see replays the jumps, the sneak and the swings", "ms": 2500}
  ],
  "closing": "Saved as recordings/wave-dance.json and put on the greeter; Preview plays it as a ghost"
}
