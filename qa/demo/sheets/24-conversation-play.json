{
  "id": "24-conversation-play",
  "title": "Conversation in play",
  "description": "Right-clicking the greeter and choosing an answer in chat",
  "target": 15,
  "stage": {
    "world": "town",
    "after": ["23-conversation-editor"],
    "console": [
      "animus edit greeter {\"name\":\"Town Greeter\",\"behaviors\":[\"plaza:welcome\"]}",
      "animus behaviors reload"
    ]
  },
  "setup": [
    {"run": "/gamemode creative"},
    {"hotbar": 8},
    {"tp": [-14, 64, 8, -90, 5]},
    {"perspective": "third-front"},
    {"wait": 600},
    {"clearChat": true},
    {"wait": 3500}
  ],
  "beats": [
    {"wait": 1100},
    {"tp": [-2.5, 64, -6.5, 180, 8]},
    {"perspective": "first"},
    {"wait": 300},
    {"lookAtEntity": "Greeter", "ms": 600},
    {"wait": 400},
    {"useItem": true},
    {"expect": "Where is the bakery", "timeout": 9000},
    {"result": "Town Greeter says the welcome line and offers [ Where is the bakery? ]", "ms": 1500},
    {"hoverChat": "Where is the bakery", "ms": 1500},
    {"clickChat": "Where is the bakery"},
    {"expect": "lanterns", "timeout": 9000},
    {"wait": 1000},
    {"result": "Town Greeter answers: Follow the lanterns to the stall.", "ms": 2500}
  ],
  "closing": "The greeter asks its question and answers the choice in chat"
}
