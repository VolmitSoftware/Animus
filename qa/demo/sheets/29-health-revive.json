    {"tp": [-14, 64, 8, -90, 5]},
    {"perspective": "third-front"},
    {"wait": 600},
    {"clearChat": true},
    {"wait": 3500}
  ],
  "beats": [
    {"wait": 600},
    {"perspective": "first"},
    {"wait": 900},
    {"tp": [43.5, 64, 0.5, -90, 8]},
