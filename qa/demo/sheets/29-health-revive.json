    {"attackTarget": true},
    {"result": "still standing, most of 20 left", "ms": 1500},
    {"type": "/animus npc health spare/spare-2 setting=maximum value=2"},
    {"result": "chat: spare-2: maximum = 2.0; the line now reads out of 2", "ms": 1500},
    {"lookAtEntity": "Spare Two", "ms": 500},
    {"attackTarget": true},
    {"result": "the health line falls to about 1 of 2", "ms": 1500},
    {"attackTarget": true},
    {"result": "almost gone, under 1 of 2", "ms": 1500},
    {"attackTarget": true},
    {"result": "the third hit kills it; Spare Two is gone", "ms": 1500},
    {"type": "/animus npc revive spare/spare-2"},
    {"wait": 500},
    {"result": "chat says it was revived, and Spare Two is back at the gate", "ms": 2500}
  ],
  "closing": "With maximum 2, Spare Two died in three hits; revive brought it back"
