{
  "id": "11-equipment",
  "title": "Equipment",
  "description": "Putting a helmet and your outfit on the greeter, then clearing its boots",
  "target": 48,
  "stage": {
    "world": "town",
    "console": [
      "animus create greeter name=Greeter world=world x=-2.5 y=64 z=-9.5",
      "animus create trader type=minecraft:llama name=Trader world=world x=4.5 y=64 z=-9.5"
    ]
  },
  "setup": [
    {"run": "/gamemode creative"},
    {"run": "/clear @s"},
    {"hotbar": 0},
    {"run": "/animus tools wand"},
    {"wait": 700},
    {"run": "/item replace entity @s hotbar.1 with golden_helmet"},
    {"run": "/item replace entity @s hotbar.2 with iron_sword"},
    {"tp": [-2.5, 64, -7, 180, 5]},
    {"wait": 500},
    {"lookAtEntity": "Greeter", "ms": 500},
    {"wait": 300},
    {"attackTarget": true, "note": "selects the greeter"},
    {"wait": 600},
    {"hotbar": 1, "note": "hold the golden helmet"},
    {"tp": [-14, 64, 8, -90, 5]},
    {"wait": 600},
    {"clearChat": true},
    {"wait": 3500}
  ],
  "beats": [
    {"perspective": "third-front"},
    {"wait": 2200, "note": "the owner's skin"},
    {"perspective": "first"},
    {"run": "/item replace entity @s armor.head with leather_helmet[dyed_color=3949738]"},
    {"run": "/item replace entity @s armor.chest with leather_chestplate[dyed_color=3949738]"},
    {"run": "/item replace entity @s armor.legs with leather_leggings[dyed_color=3949738]"},
    {"run": "/item replace entity @s armor.feet with leather_boots[dyed_color=3949738]"},
    {"wait": 600},
    {"tp": [-2.5, 64, -6, 180, 4]},
    {"wait": 400},
    {"type": "/animus tools", "note": "the greeter is selected, so its screen opens"},
    {"screen": "Greeter"},
    {"click": "Equipment"},
    {"screen": "Equipment"},
    {"result": "Equipment: armor down the left, hands, body armor and saddle on the right", "ms": 1500},
    {"hover": "Head", "ms": 1200},
    {"click": "Head"},
    {"wait": 500},
    {"result": "the golden helmet fills Head", "ms": 1500},
    {"closeScreen": true},
    {"hotbar": 2, "note": "hold the iron sword"},
    {"wait": 300},
    {"type": "/animus tools"},
    {"screen": "Greeter"},
    {"click": "Equipment"},
    {"screen": "Equipment"},
    {"hover": "Copy my outfit", "ms": 1300},
    {"click": "Copy my outfit"},
    {"wait": 500},
    {"result": "your sword and blue leather armor fill the slots", "ms": 1500},
    {"closeScreen": true},
    {"hotbar": 8, "note": "an empty hand clears a slot"},
    {"wait": 300},
    {"type": "/animus tools"},
    {"screen": "Greeter"},
    {"click": "Equipment"},
    {"screen": "Equipment"},
    {"click": "Feet"},
    {"wait": 300},
    {"hover": "Click again", "ms": 1300},
    {"click": "Click again"},
    {"wait": 500},
    {"result": "Feet is empty again", "ms": 1500},
    {"closeScreen": true},
    {"wait": 300},
    {"result": "the greeter holds the sword and wears the blue leather, without boots", "ms": 2200}
  ],
  "closing": "The greeter wears the helmet, then your outfit, and its boots are cleared"
}
