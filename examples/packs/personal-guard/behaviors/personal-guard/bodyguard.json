{
  "schemaVersion": 1,
  "revision": 1,
  "id": "personal-guard:bodyguard",
  "entry": "main",
  "routines": {
    "main": {
      "type": "sequence",
      "steps": [
        {
          "type": "action",
          "capability": "animus:look",
          "arguments": {
            "target": "player"
          }
        },
        {
          "type": "condition",
          "capability": "animus:flag-state",
          "arguments": {
            "name": "hired",
            "scope": "relationship"
          },
          "then": {
            "type": "action",
            "capability": "animus:choices",
            "arguments": {
              "id": "service",
              "prompt": "Yes, boss?",
              "options": [
                {
                  "id": "dismiss",
                  "text": "You are dismissed"
                },
                {
                  "id": "stay",
                  "text": "Carry on"
                }
              ]
            }
          },
          "else": {
            "type": "condition",
            "capability": "animus:flag-state",
            "arguments": {
              "name": "taken",
              "scope": "npc"
            },
            "then": {
              "type": "action",
              "capability": "animus:say",
              "arguments": {
                "text": "I already have a client."
              }
            },
            "else": {
              "type": "action",
              "capability": "animus:choices",
              "arguments": {
                "id": "hire",
                "prompt": "Looking for protection?",
                "options": [
                  {
                    "id": "hire",
                    "text": "You are hired"
                  },
                  {
                    "id": "pass",
                    "text": "Not now"
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "hire": {
      "type": "condition",
      "capability": "animus:flag-state",
      "arguments": {
        "name": "taken",
        "scope": "npc"
      },
      "then": {
        "type": "action",
        "capability": "animus:say",
        "arguments": {
          "text": "Too late. Someone else just hired me."
        }
      },
      "else": {
        "type": "sequence",
        "steps": [
          {
            "type": "action",
            "capability": "animus:set-flag",
            "arguments": {
              "name": "taken",
              "scope": "npc"
            }
          },
          {
            "type": "action",
            "capability": "animus:set-flag",
            "arguments": {
              "name": "hired",
              "scope": "relationship"
            }
          },
          {
            "type": "action",
            "capability": "animus:combat-control",
            "arguments": {
              "operation": "enable"
            }
          },
          {
            "type": "action",
            "capability": "animus:set-equipment",
            "arguments": {
              "slot": "main_hand",
              "item": "minecraft:iron_sword"
            }
          },
          {
            "type": "action",
            "capability": "animus:say",
            "arguments": {
              "text": "Then I will stand ready."
            }
          }
        ]
      }
    },
    "dismiss": {
      "type": "sequence",
      "steps": [
        {
          "type": "action",
          "capability": "animus:set-flag",
          "arguments": {
            "name": "hired",
            "scope": "relationship",
            "value": false
          }
        },
        {
          "type": "action",
          "capability": "animus:set-flag",
          "arguments": {
            "name": "taken",
            "scope": "npc",
            "value": false
          }
        },
        {
          "type": "action",
          "capability": "animus:combat-control",
          "arguments": {
            "operation": "release"
          }
        },
        {
          "type": "action",
          "capability": "animus:combat-control",
          "arguments": {
            "operation": "disable"
          }
        },
        {
          "type": "action",
          "capability": "animus:set-equipment",
          "arguments": {
            "slot": "main_hand"
          }
        },
        {
          "type": "action",
          "capability": "animus:say",
          "arguments": {
            "text": "Stay safe out there."
          }
        }
      ]
    },
    "stay": {
      "type": "action",
      "capability": "animus:say",
      "arguments": {
        "text": "Understood."
      }
    },
    "pass": {
      "type": "action",
      "capability": "animus:say",
      "arguments": {
        "text": "You know where to find me."
      }
    }
  },
  "triggers": [
    {
      "id": "click",
      "event": "interaction",
      "cooldownTicks": 40
    },
    {
      "id": "hired",
      "event": "dialogue_choice",
      "dialogue": "hire",
      "choice": "hire",
      "routine": "hire"
    },
    {
      "id": "passed",
      "event": "dialogue_choice",
      "dialogue": "hire",
      "choice": "pass",
      "routine": "pass"
    },
    {
      "id": "dismissed",
      "event": "dialogue_choice",
      "dialogue": "service",
      "choice": "dismiss",
      "routine": "dismiss"
    },
    {
      "id": "kept",
      "event": "dialogue_choice",
      "dialogue": "service",
      "choice": "stay",
      "routine": "stay"
    }
  ]
}
