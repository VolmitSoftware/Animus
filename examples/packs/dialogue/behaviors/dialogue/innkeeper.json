{
  "schemaVersion": 1,
  "revision": 2,
  "id": "dialogue:innkeeper",
  "entry": "main",
  "routines": {
    "main": {
      "type": "sequence",
      "steps": [
        {
          "type": "action",
          "capability": "animus:look",
          "arguments": {
            "target": "player"
          }
        },
        {
          "type": "condition",
          "capability": "animus:flag-state",
          "arguments": {
            "name": "heard-rumour",
            "scope": "relationship"
          },
          "then": {
            "type": "action",
            "capability": "animus:choices",
            "arguments": {
              "id": "topic",
              "prompt": "Back again? &7What will it be?",
              "options": [
                {
                  "id": "room",
                  "text": "A room for the night",
                  "color": "aqua",
                  "hover": "&7Rent a bed upstairs for the night"
                },
                {
                  "id": "leave",
                  "text": "Nothing, thanks",
                  "hover": "&7Say goodbye and walk away"
                }
              ]
            }
          },
          "else": {
            "type": "action",
            "capability": "animus:choices",
            "arguments": {
              "id": "topic",
              "prompt": "Welcome to the &6Crooked Lantern&f. What will it be?",
              "options": [
                {
                  "id": "rumours",
                  "text": "Heard any rumours?",
                  "color": "gold",
                  "hover": "&7Ask what the regulars are whispering about"
                },
                {
                  "id": "room",
                  "text": "A room for the night",
                  "color": "aqua",
                  "hover": "&7Rent a bed upstairs for the night"
                },
                {
                  "id": "leave",
                  "text": "Nothing, thanks",
                  "hover": "&7Say goodbye and walk away"
                }
              ]
            }
          }
        }
      ]
    },
    "rumours": {
      "type": "sequence",
      "steps": [
        {
          "type": "action",
          "capability": "animus:say",
          "arguments": {
            "text": "&eLights in the old mine&f, three nights running."
          }
        },
        {
          "type": "action",
          "capability": "animus:choices",
          "arguments": {
            "id": "mine",
            "prompt": "Want to know &emore&f?",
            "options": [
              {
                "id": "yes",
                "text": "Tell me more",
                "color": "green",
                "hover": "&7Hear the rest of the story"
              },
              {
                "id": "no",
                "text": "That is enough",
                "hover": "&7Change the subject"
              }
            ]
          }
        }
      ]
    },
    "mine-yes": {
      "type": "sequence",
      "steps": [
        {
          "type": "action",
          "capability": "animus:say",
          "arguments": {
            "text": "The miners left in a hurry. &7&oTheir tools are still down there."
          }
        },
        {
          "type": "action",
          "capability": "animus:set-flag",
          "arguments": {
            "name": "heard-rumour",
            "scope": "relationship"
          }
        }
      ]
    },
    "mine-no": {
      "type": "action",
      "capability": "animus:say",
      "arguments": {
        "text": "Suit yourself. &7Few people ask twice."
      }
    },
    "room": {
      "type": "action",
      "capability": "animus:say",
      "arguments": {
        "text": "Upstairs, &esecond door&f. &7Mind the step."
      }
    },
    "leave": {
      "type": "action",
      "capability": "animus:say",
      "arguments": {
        "text": "&aSafe roads, friend."
      }
    }
  },
  "triggers": [
    {
      "id": "click",
      "event": "interaction",
      "cooldownTicks": 40
    },
    {
      "id": "ask-rumours",
      "event": "dialogue_choice",
      "dialogue": "topic",
      "choice": "rumours",
      "routine": "rumours"
    },
    {
      "id": "ask-room",
      "event": "dialogue_choice",
      "dialogue": "topic",
      "choice": "room",
      "routine": "room"
    },
    {
      "id": "say-goodbye",
      "event": "dialogue_choice",
      "dialogue": "topic",
      "choice": "leave",
      "routine": "leave"
    },
    {
      "id": "mine-more",
      "event": "dialogue_choice",
      "dialogue": "mine",
      "choice": "yes",
      "routine": "mine-yes"
    },
    {
      "id": "mine-enough",
      "event": "dialogue_choice",
      "dialogue": "mine",
      "choice": "no",
      "routine": "mine-no"
    }
  ]
}
