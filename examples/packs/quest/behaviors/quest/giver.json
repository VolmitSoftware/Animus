{
  "schemaVersion": 1,
  "revision": 2,
  "id": "quest:giver",
  "entry": "main",
  "routines": {
    "main": {
      "type": "sequence",
      "steps": [
        {
          "type": "action",
          "capability": "animus:look",
          "arguments": {
            "target": "player"
          }
        },
        {
          "type": "condition",
          "capability": "animus:quest-state",
          "arguments": {
            "name": "letter",
            "equals": 0
          },
          "then": {
            "type": "action",
            "capability": "animus:choices",
            "arguments": {
              "id": "offer",
              "prompt": "Could you carry this &eletter&f to the &bharbour master&f?",
              "options": [
                {
                  "id": "accept",
                  "text": "I will take it",
                  "color": "green",
                  "hover": "&7Accept the delivery quest\n&8Reward: the giver's thanks"
                },
                {
                  "id": "decline",
                  "text": "Not today",
                  "hover": "&7Maybe some other day"
                }
              ]
            }
          },
          "else": {
            "type": "condition",
            "capability": "animus:quest-state",
            "arguments": {
              "name": "letter",
              "equals": 1
            },
            "then": {
              "type": "action",
              "capability": "animus:say",
              "arguments": {
                "text": "The &bharbour master&f is still waiting for that &eletter&f."
              }
            },
            "else": {
              "type": "condition",
              "capability": "animus:quest-state",
              "arguments": {
                "name": "letter",
                "equals": 2
              },
              "then": {
                "type": "sequence",
                "steps": [
                  {
                    "type": "action",
                    "capability": "animus:say",
                    "arguments": {
                      "text": "&a✔ Delivered!&f Thank you. Come back any time."
                    }
                  },
                  {
                    "type": "action",
                    "capability": "animus:set-quest-state",
                    "arguments": {
                      "name": "letter",
                      "value": 3
                    }
                  },
                  {
                    "type": "action",
                    "capability": "animus:play-sound",
                    "arguments": {
                      "sound": "minecraft:entity.player.levelup"
                    }
                  }
                ]
              },
              "else": {
                "type": "action",
                "capability": "animus:say",
                "arguments": {
                  "text": "You have done enough for me, &efriend&f."
                }
              }
            }
          }
        }
      ]
    },
    "accept": {
      "type": "sequence",
      "steps": [
        {
          "type": "action",
          "capability": "animus:advance-quest-state",
          "arguments": {
            "name": "letter",
            "maximum": 1
          }
        },
        {
          "type": "action",
          "capability": "animus:say",
          "arguments": {
            "text": "Thank you. The &bharbour master&f is by the &3docks&f."
          }
        }
      ]
    },
    "decline": {
      "type": "action",
      "capability": "animus:say",
      "arguments": {
        "text": "&7Another time, then."
      }
    }
  },
  "triggers": [
    {
      "id": "click",
      "event": "interaction",
      "cooldownTicks": 40
    },
    {
      "id": "accepted",
      "event": "dialogue_choice",
      "dialogue": "offer",
      "choice": "accept",
      "routine": "accept"
    },
    {
      "id": "declined",
      "event": "dialogue_choice",
      "dialogue": "offer",
      "choice": "decline",
      "routine": "decline"
    }
  ]
}
