{
  "protocol": 1,
  "basePath": "/animus",
  "schema": "editor-v1.schema.json",
  "headers": {
    "authorization": "Authorization: Bearer <token> on every request except hello and pair.",
    "counter": "X-Animus-Counter: a strictly increasing integer per token on every mutating request (POST and DELETE except pair, documents/read, which only reads, and DELETE /v1/token). A value at or below the last accepted one is refused with counter-replayed.",
    "retry": "A rate-limited (429) or busy (503) answer carries error.retryAfterMillis and Retry-After in whole seconds, on the direct path and in the relay response frame alike. Wait that long and send the same request again.",
    "origin": "Origin must equal one of [editor] allowedOrigins exactly, or the request is refused with origin-not-allowed."
  },
  "changeSets": {
    "write": "A change with source writes the document; baseRevision and baseHash null create one that must not exist yet.",
    "delete": "A change with delete removes the document; it needs the baseRevision and baseHash of what it removes.",
    "move": "A change with source and from moves the document from from.id to id in one transaction: the file at id is written with revision one above the old one and the file at from.id is removed. baseRevision and baseHash are those of the document at from.id. A conflict names from.id when that document changed or is gone, and id when a document already exists there. The applied answer lists id with from, the catalog event lists id and deletes from.id, and undoing the change moves the document back."
  },
  "endpoints": [
    {"method": "GET", "path": "/v1/hello", "scope": null, "request": null, "responses": {"200": "hello-response"}},
    {"method": "POST", "path": "/v1/pair", "scope": null, "auth": "pairing-secret", "request": "pair-request", "responses": {"200": "pair-response", "401": "error-response", "410": "error-response"}},
    {"method": "GET", "path": "/v1/capabilities", "scope": "read", "request": null, "responses": {"200": "capabilities-response"}},
    {"method": "GET", "path": "/v1/schemas", "scope": "read", "request": null, "responses": {"200": "schemas-response"}},
    {"method": "GET", "path": "/v1/lookups", "scope": "read", "request": null, "responses": {"200": "lookups-response"}},
    {"method": "GET", "path": "/v1/catalog", "scope": "read", "query": {"kind": "kind", "after": "string"}, "request": null, "responses": {"200": "catalog-response"}},
    {"method": "GET", "path": "/v1/documents/{kind}/{id}", "scope": "read", "request": null, "responses": {"200": "document-response", "404": "error-response"}},
    {"method": "POST", "path": "/v1/documents/read", "scope": "read", "counter": false, "request": "documents-read-request", "responses": {"200": "documents-read-response", "400": "error-response"}},
    {"method": "GET", "path": "/v1/skins/{hash}/texture.png", "scope": "read", "request": null, "responses": {"200": "image/png", "404": "error-response"}},
    {"method": "POST", "path": "/v1/validate", "scope": "validate", "request": "validate-request", "responses": {"200": "validate-response"}},
    {"method": "POST", "path": "/v1/previews", "scope": "preview", "request": "preview-request", "responses": {"200": "preview-response", "409": "error-response", "422": "error-response"}},
    {"method": "DELETE", "path": "/v1/previews/{previewId}", "scope": "preview", "request": null, "responses": {"204": null, "404": "error-response"}},
    {"method": "DELETE", "path": "/v1/token", "scope": null, "counter": false, "description": "The bearer token revokes itself: its event streams close and its previews end. Not rate limited; a token already revoked answers 204 again.", "request": null, "responses": {"204": null, "401": "error-response"}},
    {"method": "POST", "path": "/v1/changes", "scope": "apply:*", "request": "change-set", "responses": {"200": "change-applied", "409": "change-conflict", "422": "change-invalid"}},
    {"method": "GET", "path": "/v1/changes/{idempotencyKey}", "scope": "read", "request": null, "responses": {"200": "change-status-response"}},
    {"method": "POST", "path": "/v1/changes/{changeId}/undo", "scope": "apply:*", "request": "undo-request", "responses": {"200": "change-applied", "409": "change-conflict"}},
    {"method": "GET", "path": "/v1/imports", "scope": "import", "request": null, "responses": {"200": "import-review"}},
    {"method": "POST", "path": "/v1/imports", "scope": "import", "query": {"file": "citizens|shopkeepers|shopkeepers-config|dtltraders", "name": "dtltraders file: guis.yml, config.yml, messages.yml, data.dat or shops/<shop>/<shop>.yml"}, "request": "application/octet-stream", "responses": {"200": "import-review", "400": "error-response", "403": "error-response", "409": "error-response", "413": "error-response"}},
    {"method": "POST", "path": "/v1/imports/stage", "scope": "import", "request": "import-stage-request", "responses": {"200": "import-review", "400": "error-response", "403": "error-response"}},
    {"method": "POST", "path": "/v1/imports/{importId}/apply", "scope": "import", "applyScopes": ["apply:npcs", "apply:behaviors", "apply:gui"], "request": null, "responses": {"200": "import-review", "409": "error-response"}},
    {"method": "POST", "path": "/v1/imports/{importId}/rollback", "scope": "import", "applyScopes": ["apply:npcs", "apply:behaviors", "apply:gui"], "request": null, "responses": {"200": "import-review", "409": "error-response"}},
    {"method": "POST", "path": "/v1/npcs/{id}/spawn", "scope": "spawn", "request": null, "responses": {"200": "spawn-response"}},
    {"method": "POST", "path": "/v1/npcs/{id}/despawn", "scope": "spawn", "request": null, "responses": {"200": "spawn-response"}},
    {"method": "GET", "path": "/v1/terrain/surface", "scope": "terrain", "query": {"world": "world name", "tx": "tile x, blocks / 64", "tz": "tile z, blocks / 64"}, "headers": ["If-None-Match"], "request": null, "responses": {"200": "terrain-surface-response", "304": null, "400": "error-response", "404": "error-response", "413": "error-response", "504": "error-response"}},
    {"method": "GET", "path": "/v1/terrain/blocks", "scope": "terrain", "query": {"world": "world name", "cx": "chunk x", "cz": "chunk z", "y": "lowest layer", "height": "1 to 64 layers"}, "headers": ["If-None-Match"], "request": null, "responses": {"200": "terrain-blocks-response", "304": null, "400": "error-response", "404": "error-response", "413": "error-response", "504": "error-response"}},
    {"method": "GET", "path": "/v1/terrain/position", "scope": "terrain", "query": {"npc": "NPC id, its path under npcs/ such as town/guard"}, "request": null, "responses": {"200": "terrain-position-response", "400": "error-response", "403": "error-response", "404": "error-response"}},
    {"method": "WS", "path": "/v1/events", "scope": "read", "request": "event-auth", "responses": {"frame": "event"}}
  ],
  "errorStatus": {
    "unauthorized": 401, "token-expired": 401, "token-revoked": 401, "pairing-invalid": 401, "pairing-expired": 410,
    "scope-missing": 403, "group-denied": 403, "origin-not-allowed": 403, "counter-replayed": 409,
    "not-found": 404, "invalid-request": 400, "too-large": 413, "rate-limited": 429, "busy": 503,
    "conflict": 409, "preview-refused": 422, "player-offline": 409, "gloss-unavailable": 422,
    "unsupported-protocol": 400, "server-offline": 503, "timeout": 504, "internal": 500, "world-unloaded": 404
  },
  "kinds": {
    "npc": {"folder": "npcs", "applyScope": "apply:npcs", "schema": "generated/npc.schema.json"},
    "route": {"folder": "routes", "applyScope": "apply:npcs", "schema": "generated/route.schema.json"},
    "recording": {"folder": "recordings", "applyScope": "apply:npcs", "schema": "recording-v1.schema.json"},
    "skin": {"folder": "skins", "applyScope": "apply:npcs", "schema": null},
    "group": {"folder": "groups", "applyScope": "apply:npcs", "schema": "group-v1.schema.json"},
    "behavior": {"folder": "behaviors", "applyScope": "apply:behaviors", "schema": "generated/behavior.schema.json"},
    "pack": {"folder": "packs", "applyScope": "apply:behaviors", "schema": "generated/pack.schema.json"},
    "shop": {"folder": "shops", "applyScope": "apply:gui", "schema": "shop-v1.schema.json"},
    "quest": {"folder": "quests", "applyScope": "apply:behaviors", "schema": "quest-v1.schema.json"},
    "inventory": {"folder": "gui/inventories", "applyScope": "apply:gui", "schema": "gui-inventory-v1.schema.json"},
    "menu": {"folder": "gui/menus", "applyScope": "apply:gui", "schema": "gloss/gloss.schema.json"},
    "hologram": {"folder": "gui/holograms", "applyScope": "apply:gui", "schema": "gloss/gloss-holograms.schema.json"},
    "text-animation": {"folder": "gui/text-animations", "applyScope": "apply:gui", "schema": null},
    "presets": {"folder": "gui", "applyScope": "apply:gui", "schema": "gloss/gloss-presets.schema.json"},
    "rig": {"folder": "rigs", "applyScope": "apply:rigs", "schema": "rig-v1.schema.json"},
    "animation": {"folder": "animations", "applyScope": "apply:rigs", "schema": "animation-v1.schema.json"},
    "server-behaviors": {"folder": "", "applyScope": "apply:behaviors", "schema": "server-behaviors-v1.schema.json"}
  },
  "pairing": {
    "prefix": "ANM1.",
    "linkTemplate": "https://animus.volmitsoftware.com/#/pair/{code}",
    "secretMinutes": 10,
    "defaultTokenDays": 7,
    "slidingExpiry": "A token expires defaultTokenDays (or its expires= lifetime) after its last use; each use moves expiresAt forward.",
    "defaultScopes": ["read", "validate", "preview", "apply:npcs", "apply:behaviors", "apply:gui", "apply:rigs", "import", "spawn", "terrain"],
    "tokenRecheckSeconds": 60
  },
  "limits": {
    "requestBodyBytes": 4194304,
    "importBodyBytes": 16777216,
    "changeSetDocuments": 512,
    "catalogPageSize": 1000,
    "catalogPageBytes": 524288,
    "documentsReadRefs": 200,
    "documentsReadBytes": 524288,
    "catalogEventFrameBytes": 49152,
    "concurrentRequestsPerToken": 8,
    "openConnections": 64,
    "eventFramesPerSecond": 20,
    "eventAuthSeconds": 10,
    "previewsPerServer": 4,
    "npcsPerPreview": 64,
    "previewMinutes": 15,
    "idempotencyHours": 24,
    "terrainRadius": 160,
    "terrainBodyBytes": 524288,
    "relayFrameBytes": 1048576,
    "relayMessagesPerSecond": 120,
    "relayPendingRequests": 64,
    "relayTimeoutSeconds": 10,
    "relayPingSeconds": 30
  },
  "relay": {
    "agentPath": "/agent",
    "appPath": "/app",
    "challengePrefix": "animus-relay/1 ",
    "streamPath": "/v1/events",
    "closeCode": 4008,
    "relayHeaders": ["Origin", "X-Forwarded-For"],
    "agentToRelay": ["relay-register", "relay-response", "relay-event", "relay-close"],
    "relayToAgent": ["relay-challenge", "relay-registered", "relay-request", "relay-close", "relay-error"],
    "appToRelay": ["relay-subscribe", "relay-request", "relay-close"],
    "relayToApp": ["relay-subscribed", "relay-status", "relay-response", "relay-event", "relay-close", "relay-error"]
  },
  "previewRefusedCapabilities": ["animus:command", "animus:combat-control"],
  "previewRefusedGuiActions": ["command", "give", "take", "economy", "animus:trade"]
}
