{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animus.volmitsoftware.com/schema/rig-v1.schema.json",
  "title": "Animus rig",
  "description": "rigs/<namespace>/<path>.json. A tree of bones shown as packet-only display entities. Rules a schema cannot express (unique bone ids, parents listed before children, depth at most 16, socket and animation references) are checked by the rig validators; see dev/editor-contracts.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "id", "bones"],
  "properties": {
    "schemaVersion": {"const": 1},
    "revision": {"type": "integer", "minimum": 1},
    "id": {"$ref": "#/$defs/documentId", "description": "namespace:path, matching this file's location."},
    "units": {"const": "blocks", "description": "Pivots and translations are in blocks. Blockbench pixels are divided by 16 on import."},
    "body": {"enum": ["hidden", "shown"], "description": "hidden: only the rig shows and the hidden body keeps the hitbox. shown: the vanilla body shows and the rig adds parts. Defaults to hidden."},
    "bones": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/bone"}},
    "sockets": {
      "type": "object",
      "description": "Equipment slot to bone id.",
      "propertyNames": {"enum": ["main_hand", "off_hand", "head", "chest", "legs", "feet", "body", "saddle"]},
      "additionalProperties": {"$ref": "#/$defs/boneId"}
    },
    "animations": {
      "type": "object",
      "description": "Named animations; idle and walk are switched by navigation.",
      "propertyNames": {"pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
      "additionalProperties": {"$ref": "#/$defs/documentId"}
    }
  },
  "$defs": {
    "documentId": {"type": "string", "maxLength": 256, "pattern": "^[a-z0-9_-]{1,64}:[a-z0-9_-]{1,64}(/[a-z0-9_-]{1,64}){0,14}$"},
    "boneId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "vector": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": -1024, "maximum": 1024}},
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "pattern": "^([a-z0-9_.-]+:)?[a-z0-9_./-]+$"},
        "count": {"type": "integer", "minimum": 1, "maximum": 99},
        "components": {"type": "string", "maxLength": 4096, "pattern": "^\\[[\\s\\S]*\\]$"}
      }
    },
    "visual": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"enum": ["item", "block", "text", "none"]},
        "translation": {"$ref": "#/$defs/vector", "description": "Offset from the bone origin, in blocks, in the bone's space."},
        "rotation": {"$ref": "#/$defs/vector", "description": "Euler degrees in the bone's space, applied X then Y then Z."},
        "scale": {"$ref": "#/$defs/vector"}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "item"}}},
         "then": {"required": ["item"], "propertyNames": {"enum": ["type", "translation", "rotation", "scale", "item", "itemDisplay"]},
                  "properties": {"item": {"$ref": "#/$defs/item"},
                                 "itemDisplay": {"enum": ["none", "thirdperson_lefthand", "thirdperson_righthand", "firstperson_lefthand", "firstperson_righthand", "head", "gui", "ground", "fixed"]}}}},
        {"if": {"properties": {"type": {"const": "block"}}},
         "then": {"required": ["block"], "propertyNames": {"enum": ["type", "translation", "rotation", "scale", "block"]},
                  "properties": {"block": {"type": "string", "maxLength": 1024, "pattern": "^([a-z0-9_.-]+:)?[a-z0-9_./-]+(\\[[^\\]]*\\])?$"}}}},
        {"if": {"properties": {"type": {"const": "text"}}},
         "then": {"required": ["text"], "propertyNames": {"enum": ["type", "translation", "rotation", "scale", "text", "billboard", "background", "shadow", "lineWidth"]},
                  "properties": {"text": {"type": "string", "maxLength": 1024},
                                 "billboard": {"enum": ["fixed", "vertical", "horizontal", "center"]},
                                 "background": {"type": "string", "pattern": "^#[0-9a-fA-F]{8}$"},
                                 "shadow": {"type": "boolean"},
                                 "lineWidth": {"type": "integer", "minimum": 1, "maximum": 1024}}}},
        {"if": {"properties": {"type": {"const": "none"}}},
         "then": {"propertyNames": {"enum": ["type"]}}}
      ]
    },
    "bone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "pivot"],
      "properties": {
        "id": {"$ref": "#/$defs/boneId"},
        "parent": {"$ref": "#/$defs/boneId", "description": "An earlier bone. Bones without a parent hang from the rig origin."},
        "pivot": {"$ref": "#/$defs/vector", "description": "Rest position of the bone origin in rig space, in blocks. Rotations and scales turn about it."},
        "rotation": {"$ref": "#/$defs/vector", "description": "Rest rotation, Euler degrees applied X then Y then Z."},
        "visual": {"$ref": "#/$defs/visual"}
      }
    }
  }
}
