{
  "schemaVersion": 1,
  "revision": 1,
  "id": "denizen:interact/smith_interact",
  "entry": "task-smith_reward",
  "variables": {
    "d_count": {
      "type": "any",
      "initial": ""
    },
    "d_helper": {
