{
  "schemaVersion": 1,
  "revision": 1,
  "id": "denizen:interact/guard_quest",
  "entry": "click",
  "routines": {
    "click": {
      "type": "condition",
      "capability": "animus:quest-state",
      "arguments": {
        "name": "interact-guard_quest",
        "scope": "relationship",
        "equals": 0
      },
      "then": {
        "type": "call",
        "routine": "s0-click"
      },
      "else": {
        "type": "condition",
        "capability": "animus:quest-state",
        "arguments": {
          "name": "interact-guard_quest",
          "scope": "relationship",
          "equals": 1
        },
        "then": {
          "type": "call",
          "routine": "s1-click"
        },
        "else": {
          "type": "condition",
          "capability": "animus:quest-state",
          "arguments": {
            "name": "interact-guard_quest",
            "scope": "relationship",
            "equals": 2
          },
          "then": {
            "type": "call",
            "routine": "s2-click"
          }
        }
      }
    },
    "enter": {
      "type": "condition",
      "capability": "animus:quest-state",
      "arguments": {
        "name": "interact-guard_quest",
        "scope": "relationship",
        "equals": 1
      },
      "then": {
        "type": "call",
        "routine": "s1-enter"
      }
    },
    "s0-chat-1": {
      "type": "sequence",
      "steps": [
        {
          "type": "action",
          "capability": "animus:message",
          "arguments": {
            "text": "Thank you."
          }
        },
        {
          "type": "action",
          "capability": "animus:set-quest-state",
          "arguments": {
            "name": "interact-guard_quest",
            "scope": "relationship",
            "value": 1
          }
        }
      ]
    },
    "s0-click": {
      "type": "sequence",
      "steps": [
        {
          "type": "action",
          "capability": "animus:message",
          "arguments": {
            "text": "Bring me something else."
          }
        },
        {
          "type": "action",
          "capability": "animus:choices",
          "arguments": {
            "id": "guard_quest-s0",
            "prompt": "Choose a reply",
            "options": [
              {
                "id": "c1",
                "text": "Yes I will help"
              }
            ]
          }
        }
      ]
    },
    "s1-enter": {
      "type": "action",
      "capability": "animus:message",
      "arguments": {
        "text": "Still gathering?"
      }
    },
    "s1-click": {
      "type": "condition",
      "expression": "num(flag('player', 'visits', 0)) >= 3",
      "then": {
        "type": "condition",
        "capability": "animus:has-permission",
        "arguments": {
          "permission": "town.quest"
        },
        "then": {
          "type": "sequence",
          "steps": [
            {
              "type": "action",
              "capability": "animus:command",
              "arguments": {
                "command": null
              },
              "templates": {
                "/command": "give {{ player.name }} minecraft:emerald 1"
              }
            },
            {
              "type": "action",
              "capability": "animus:set-quest-state",
              "arguments": {
                "name": "interact-guard_quest",
                "scope": "relationship",
                "value": 2
              }
            }
          ]
        },
        "else": {
          "type": "condition",
          "expression": "!(npc.spawned)",
          "then": {
            "type": "action",
            "capability": "animus:message",
            "arguments": {
              "text": "How odd."
            }
          },
          "else": {
            "type": "action",
            "capability": "animus:message",
            "arguments": {
              "text": "Come back later."
            }
          }
        }
      },
      "else": {
        "type": "condition",
        "expression": "!(npc.spawned)",
        "then": {
          "type": "action",
          "capability": "animus:message",
          "arguments": {
            "text": "How odd."
          }
        },
        "else": {
          "type": "action",
          "capability": "animus:message",
          "arguments": {
            "text": "Come back later."
          }
        }
      }
    },
    "s2-click": {
      "type": "sequence",
      "steps": [
        {
          "type": "action",
          "capability": "animus:message",
          "arguments": {
            "text": "&#ffaa00You did it❤"
          }
        },
        {
          "type": "action",
          "capability": "animus:give-item",
          "arguments": {
            "item": "minecraft:diamond",
            "amount": 2
          }
        },
        {
          "type": "action",
          "capability": "animus:take-item",
          "arguments": {
            "item": "minecraft:dirt",
            "amount": 3
          }
        }
      ]
    }
  },
  "triggers": [
    {
      "id": "click",
      "event": "interaction",
      "routine": "click",
      "cooldownTicks": 40
    },
    {
      "id": "enter",
      "event": "proximity",
      "phase": "enter",
      "radius": 6,
      "routine": "enter"
    },
    {
      "id": "s0-c1",
      "event": "dialogue_choice",
      "dialogue": "guard_quest-s0",
      "choice": "c1",
      "routine": "s0-chat-1"
    }
  ]
}
