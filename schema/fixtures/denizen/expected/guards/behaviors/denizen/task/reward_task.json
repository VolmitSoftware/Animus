{
  "schemaVersion": 1,
  "revision": 1,
  "id": "denizen:task/reward_task",
  "entry": "main",
  "routines": {
    "main": {
      "type": "sequence",
      "steps": [
        {
          "type": "condition",
          "expression": "!(has_flag('player', 'vip'))",
          "then": {
            "type": "sequence",
            "steps": [
              {
                "type": "action",
                "capability": "animus:message",
                "arguments": {
                  "text": "VIP only."
                }
              },
              {
                "type": "return"
              }
            ]
          }
        },
        {
          "type": "return"
        }
      ]
    }
  }
}
