{
  "schemaVersion": 1,
  "revision": 1,
  "id": "denizen:task/greet_task",
  "entry": "main",
  "variables": {
    "d_count": {
      "type": "any",
      "initial": ""
    },
    "d_piece": {
      "type": "any",
      "initial": ""
    },
    "i_1": {
      "type": "integer",
      "initial": 0
    },
    "t_1": {
      "type": "any",
      "initial": ""
    },
    "t_2": {
      "type": "any",
      "initial": ""
    }
  },
  "routines": {
    "main": {
      "type": "sequence",
      "steps": [
        {
          "type": "set",
          "variable": "d_count",
          "value": 3
        },
        {
          "type": "action",
          "capability": "animus:message",
          "arguments": {
            "text": null
          },
          "templates": {
            "/text": "{{ d_count }} greetings."
          }
        },
        {
          "type": "wait",
          "ticks": 40
        },
        {
          "type": "action",
          "capability": "animus:spawn-particle",
          "arguments": {
            "particle": "minecraft:happy_villager",
            "count": 10,
            "spread": 0.5,
            "audience": "nearby"
          }
        },
        {
          "type": "repeat",
          "count": 2,
          "body": {
            "type": "action",
            "capability": "animus:message",
            "arguments": {
              "text": "Wave."
            }
          }
        },
        {
          "type": "set",
          "variable": "t_1",
          "value": {
            "expression": "flag('player', 'visits', '')"
          }
        },
        {
          "type": "condition",
          "expression": "same(t_1, 1)",
          "then": {
            "type": "action",
            "capability": "animus:message",
            "arguments": {
              "text": "First visit."
            }
          },
          "else": {
            "type": "action",
            "capability": "animus:message",
            "arguments": {
              "text": "Again."
            }
          }
        },
        {
          "type": "action",
          "capability": "animus:title",
          "arguments": {
            "title": "Guard",
            "subtitle": null,
            "fadeIn": 20,
            "stay": 40,
            "fadeOut": 20
          },
          "templates": {
            "/subtitle": "{{ player.name }}"
          }
        },
        {
          "type": "action",
          "capability": "animus:actionbar",
          "arguments": {
            "text": "&eVisit logged"
          }
        },
        {
          "type": "call",
          "routine": "task-greet_task-extra"
        },
        {
          "type": "foreach",
          "list": {
            "expression": "['sword', 'shield', 'helmet']"
          },
          "as": "d_piece",
          "index": "i_1",
          "body": {
            "type": "sequence",
            "steps": [
              {
                "type": "condition",
                "expression": "same(d_piece, 'shield')",
                "then": {
                  "type": "continue"
                }
              },
              {
                "type": "action",
                "capability": "animus:message",
                "arguments": {
                  "text": null
                },
                "templates": {
                  "/text": "{{ (i_1 + 1) }}. {{ upper(text(d_piece)) }}"
                }
              }
            ]
          }
        },
        {
          "type": "set",
          "variable": "t_2",
          "value": {
            "expression": "random(1, 3)"
          }
        },
        {
          "type": "condition",
          "expression": "same(t_2, 1)",
          "then": {
            "type": "action",
            "capability": "animus:say",
            "arguments": {
              "text": "A fine day.",
              "audience": "nearby"
            }
          },
          "else": {
            "type": "condition",
            "expression": "(same(t_2, 2) || same(t_2, 3))",
            "then": {
              "type": "action",
              "capability": "animus:say",
              "arguments": {
                "text": "Stay alert.",
                "audience": "nearby"
              }
            }
          }
        },
        {
          "type": "while",
          "expression": "num(d_count) > 0",
          "maximum": 1024,
          "body": {
            "type": "set",
            "variable": "d_count",
            "value": {
              "expression": "(num(d_count) - 1)"
            }
          }
        },
        {
          "type": "action",
          "capability": "animus:give-item",
          "arguments": {
            "item": "minecraft:torch",
            "amount": null,
            "name": "&6Lantern token",
            "lore": [
              "Shown at the gate"
            ]
          },
          "expressions": {
            "/amount": "int((num(d_count) + 1))"
          }
        },
        {
          "type": "action",
          "capability": "animus:set-appearance",
          "arguments": {
            "name": "Gate Guard"
          }
        }
      ]
    },
    "task-greet_task-extra": {
      "type": "sequence",
      "steps": [
        {
          "type": "action",
          "capability": "animus:message",
          "arguments": {
            "text": "Extra path."
          }
        },
        {
          "type": "action",
          "capability": "animus:teleport",
          "arguments": {
            "to": "npc"
          }
        }
      ]
    }
  }
}
