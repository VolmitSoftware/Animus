{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Animus NPC definition",
  "description": "npcs/<group>/<id>.json. Unknown fields and modules are kept as written.",
  "type": "object",
  "required": [
    "schemaVersion",
    "revision",
    "uuid",
    "id",
    "group",
    "name",
    "type",
    "spawned",
    "position"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807,
      "description": "Raise this with every edit."
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "A canonical lowercase UUID that never changes."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "description": "Matches the file name."
    },
    "group": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "description": "Matches the directory name."
    },
    "name": {
      "type": "string",
      "pattern": "\\S",
      "description": "The displayed name."
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z0-9_]+:[a-z0-9_/]+$",
      "description": "An entity type such as minecraft:player."
    },
    "spawned": {
      "type": "boolean",
      "description": "Whether the NPC is presented."
    },
    "position": {
      "type": "object",
      "required": [
        "world",
        "x",
        "y",
        "z",
        "yaw",
        "pitch"
      ],
      "properties": {
        "world": {
          "type": "string",
          "pattern": "\\S"
        },
        "x": {
          "type": "number",
          "minimum": -30000000,
          "maximum": 30000000
        },
        "y": {
          "type": "number",
          "minimum": -30000000,
          "maximum": 30000000
        },
        "z": {
          "type": "number",
          "minimum": -30000000,
          "maximum": 30000000
        },
        "yaw": {
          "type": "number",
          "minimum": -30000000,
          "maximum": 30000000
        },
        "pitch": {
          "type": "number",
          "minimum": -30000000,
          "maximum": 30000000
        }
      }
    },
    "skin": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of a skin document under skins/."
    },
    "behaviors": {
      "type": "array",
      "description": "Behaviors whose triggers this NPC runs.",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_-]+:[a-z0-9_/-]+$"
      }
    },
    "tags": {
      "type": "array",
      "description": "Labels for finding and grouping NPCs in the editor; at most 32.",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "rig": {
      "type": "object",
      "description": "The rig under rigs/ this NPC's body shows.",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{1,64}:[a-z0-9_-]{1,64}(/[a-z0-9_-]{1,64}){0,14}$"
        }
      }
    },
    "modules": {
      "type": "object",
      "description": "Per-NPC module settings, keyed by namespace:name. Unknown modules are kept.",
      "properties": {
        "animus:navigation": {
          "type": "object",
          "description": "Native waypoints, or a reusable route under routes/.",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "reviewAccepted": {
              "type": "boolean"
            },
            "route": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
            },
            "recording": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
              "maxLength": 64,
              "description": "A recording under recordings/ to play instead of a route."
            },
            "playback": {
              "enum": [
                "once",
                "loop",
                "pingpong"
              ],
              "description": "Recording only: once, loop (the default) or pingpong."
            },
            "mode": {
              "enum": [
                "walk",
                "swim",
                "fly"
              ]
            },
            "speed": {
              "type": "number",
              "minimum": 1,
              "maximum": 5
            },
            "order": {
              "enum": [
                "sequence",
                "pingpong",
                "random",
                "wander"
              ],
              "description": "How the next point is chosen. sequence by default."
            },
            "loop": {
              "type": "boolean",
              "description": "Order sequence only: start again from the first point."
            },
            "waitTicks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 12000,
              "description": "Wait before the first leg and after each arrival."
            },
            "points": {
              "type": "array",
              "description": "Route points in the NPC's world; wander centres for order wander.",
              "minItems": 0,
              "maxItems": 256,
              "items": {
                "type": "object",
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": -29999984,
                    "maximum": 29999984
                  },
                  "y": {
                    "type": "number",
                    "minimum": -29999984,
                    "maximum": 29999984
                  },
                  "z": {
                    "type": "number",
                    "minimum": -29999984,
                    "maximum": 29999984
                  },
                  "waitTicks": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 12000,
                    "description": "Wait after arriving here, instead of the route's."
                  }
                }
              }
            },
            "guides": {
              "type": "array",
              "description": "Order random only: helper nodes a path may pass through.",
              "minItems": 0,
              "maxItems": 1024,
              "items": {
                "type": "object",
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": -29999984,
                    "maximum": 29999984
                  },
                  "y": {
                    "type": "number",
                    "minimum": -29999984,
                    "maximum": 29999984
                  },
                  "z": {
                    "type": "number",
                    "minimum": -29999984,
                    "maximum": 29999984
                  }
                }
              }
            },
            "linkDistance": {
              "type": "number",
              "minimum": 1.0,
              "maximum": 256.0,
              "description": "Order random only: the longest link between two nodes."
            },
            "wander": {
              "type": "object",
              "description": "Order wander only.",
              "additionalProperties": false,
              "properties": {
                "radius": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 32
                },
                "height": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 8
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "then": {
                "if": {
                  "required": [
                    "route"
                  ]
                },
                "then": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "points"
                        ]
                      },
                      {
                        "required": [
                          "mode"
                        ]
                      },
                      {
                        "required": [
                          "speed"
                        ]
                      },
                      {
                        "required": [
                          "order"
                        ]
                      },
                      {
                        "required": [
                          "loop"
                        ]
                      },
                      {
                        "required": [
                          "waitTicks"
                        ]
                      },
                      {
                        "required": [
                          "guides"
                        ]
                      },
                      {
                        "required": [
                          "linkDistance"
                        ]
                      },
                      {
                        "required": [
                          "wander"
                        ]
                      },
                      {
                        "required": [
                          "recording"
                        ]
                      }
                    ]
                  }
                },
                "else": {
                  "if": {
                    "required": [
                      "recording"
                    ]
                  },
                  "then": {
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "points"
                          ]
                        },
                        {
                          "required": [
                            "mode"
                          ]
                        },
                        {
                          "required": [
                            "speed"
                          ]
                        },
                        {
                          "required": [
                            "order"
                          ]
                        },
                        {
                          "required": [
                            "loop"
                          ]
                        },
                        {
                          "required": [
                            "waitTicks"
                          ]
                        },
                        {
                          "required": [
                            "guides"
                          ]
                        },
                        {
                          "required": [
                            "linkDistance"
                          ]
                        },
                        {
                          "required": [
                            "wander"
                          ]
                        }
                      ]
                    }
                  },
                  "else": {
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "order": {
                              "const": "wander"
                            }
                          },
                          "required": [
                            "order"
                          ]
                        },
                        "then": {
                          "properties": {
                            "points": {
                              "maxItems": 64
                            }
                          }
                        },
                        "else": {
                          "required": [
                            "points"
                          ],
                          "properties": {
                            "points": {
                              "minItems": 1
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "then": {
                "if": {
                  "required": [
                    "playback"
                  ]
                },
                "then": {
                  "required": [
                    "recording"
                  ]
                }
              }
            },
            {
              "if": {
                "required": [
                  "loop"
                ]
              },
              "then": {
                "properties": {
                  "order": {
                    "const": "sequence"
                  }
                }
              }
            },
            {
              "if": {
                "required": [
                  "guides"
                ]
              },
              "then": {
                "properties": {
                  "order": {
                    "const": "random"
                  }
                },
                "required": [
                  "order"
                ]
              }
            },
            {
              "if": {
                "required": [
                  "linkDistance"
                ]
              },
              "then": {
                "properties": {
                  "order": {
                    "const": "random"
                  }
                },
                "required": [
                  "order"
                ]
              }
            },
            {
              "if": {
                "required": [
                  "wander"
                ]
              },
              "then": {
                "properties": {
                  "order": {
                    "const": "wander"
                  }
                },
                "required": [
                  "order"
                ]
              }
            }
          ]
        },
        "animus:mount": {
          "type": "object",
          "description": "Rides another NPC.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "vehicle": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
              "description": "The vehicle NPC's id."
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": false
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "else": {
                "required": [
                  "vehicle"
                ]
              }
            }
          ]
        },
        "animus:riding": {
          "type": "object",
          "description": "Lets a real player ride this NPC.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "reviewAccepted": {
              "type": "boolean"
            },
            "permission": {
              "type": "string"
            },
            "speed": {
              "type": "number"
            },
            "leash": {
              "type": "number"
            },
            "lifetimeSeconds": {
              "type": "number"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "then": {
                "properties": {
                  "permission": {
                    "type": "string",
                    "pattern": "^[a-z0-9_-]+(\\.[a-z0-9_-]+)*$",
                    "maxLength": 128
                  },
                  "speed": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 8.0
                  },
                  "leash": {
                    "type": "number",
                    "minimum": 4.0,
                    "maximum": 256.0
                  },
                  "lifetimeSeconds": {
                    "type": "integer",
                    "minimum": 30,
                    "maximum": 3600
                  }
                }
              }
            }
          ]
        },
        "animus:look-close": {
          "type": "object",
          "description": "Turns the NPC toward the nearest player in range while it is spawned.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "True when the object is present."
            },
            "range": {
              "type": "number",
              "minimum": 1.0,
              "maximum": 64.0,
              "description": "Blocks. 10 by default."
            },
            "lineOfSight": {
              "type": "boolean",
              "description": "Only look at players it can see."
            },
            "whileNavigating": {
              "type": "boolean",
              "description": "Also look while following a route."
            },
            "npcs": {
              "type": "boolean",
              "description": "Also look at the nearest other NPC when no player is in range."
            },
            "randomLook": {
              "type": "object",
              "description": "With nobody to look at, turn to a random facing every delayTicks.",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "True by default."
                },
                "delayTicks": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 12000,
                  "description": "Ticks between random turns. 60 by default."
                },
                "yaw": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -360,
                    "maximum": 360
                  },
                  "minItems": 2,
                  "maxItems": 2,
                  "description": "[minimum, maximum] yaw in degrees. [0, 360] by default."
                },
                "pitch": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "minItems": 2,
                  "maxItems": 2,
                  "description": "[minimum, maximum] pitch in degrees. [0, 0] by default."
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "migration"
        ]
      },
      "then": {
        "properties": {
          "modules": {
            "properties": {
              "animus:navigation": {
                "if": {
                  "properties": {
                    "enabled": {
                      "const": true
                    }
                  },
                  "required": [
                    "enabled"
                  ]
                },
                "then": {
                  "required": [
                    "reviewAccepted"
                  ],
                  "properties": {
                    "reviewAccepted": {
                      "const": true
                    }
                  }
                }
              },
              "animus:riding": {
                "if": {
                  "properties": {
                    "enabled": {
                      "const": true
                    }
                  },
                  "required": [
                    "enabled"
                  ]
                },
                "then": {
                  "required": [
                    "reviewAccepted"
                  ],
                  "properties": {
                    "reviewAccepted": {
                      "const": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
