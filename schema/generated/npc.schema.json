{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Animus NPC definition",
  "description": "npcs/<group>/<id>.json. Unknown fields and modules are kept as written.",
  "type": "object",
  "required": [
    "schemaVersion",
    "revision",
    "uuid",
    "id",
    "group",
    "name",
    "type",
    "spawned",
    "position"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807,
      "description": "Raise this with every edit."
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "A canonical lowercase UUID that never changes."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "description": "Matches the file name."
    },
    "group": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "description": "Matches the directory name."
    },
    "name": {
      "type": "string",
      "pattern": "\\S",
      "description": "The displayed name."
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z0-9_]+:[a-z0-9_/]+$",
      "description": "An entity type such as minecraft:player."
    },
    "spawned": {
      "type": "boolean",
      "description": "Whether the NPC is presented."
    },
    "position": {
      "type": "object",
      "required": [
        "world",
        "x",
        "y",
        "z",
        "yaw",
        "pitch"
      ],
      "properties": {
        "world": {
          "type": "string",
          "pattern": "\\S"
        },
        "x": {
          "type": "number",
          "minimum": -30000000,
          "maximum": 30000000
        },
        "y": {
          "type": "number",
          "minimum": -30000000,
          "maximum": 30000000
        },
        "z": {
          "type": "number",
          "minimum": -30000000,
          "maximum": 30000000
        },
        "yaw": {
          "type": "number",
          "minimum": -30000000,
          "maximum": 30000000
        },
        "pitch": {
          "type": "number",
          "minimum": -30000000,
          "maximum": 30000000
        }
      }
    },
    "skin": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of a skin document under skins/."
    },
    "behaviors": {
      "type": "array",
      "description": "Behaviors whose triggers this NPC runs.",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_-]+:[a-z0-9_/-]+$"
      }
    },
    "rig": {
      "type": "object",
      "description": "The rig under rigs/ this NPC's body shows.",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{1,64}:[a-z0-9_-]{1,64}(/[a-z0-9_-]{1,64}){0,14}$"
        }
      }
    },
    "modules": {
      "type": "object",
      "description": "Per-NPC module settings, keyed by namespace:name. Unknown modules are kept.",
      "properties": {
        "animus:navigation": {
          "type": "object",
          "description": "Native waypoints, or a reusable route under routes/.",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "reviewAccepted": {
              "type": "boolean"
            },
            "route": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
            },
            "mode": {
              "enum": [
                "walk",
                "swim",
                "fly"
              ]
            },
            "speed": {
              "type": "number",
              "minimum": 1,
              "maximum": 5
            },
            "loop": {
              "type": "boolean"
            },
            "waitTicks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 12000
            },
            "points": {
              "type": "array",
              "description": "Route points in the NPC's world.",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": -29999984,
                    "maximum": 29999984
                  },
                  "y": {
                    "type": "number",
                    "minimum": -29999984,
                    "maximum": 29999984
                  },
                  "z": {
                    "type": "number",
                    "minimum": -29999984,
                    "maximum": 29999984
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "then": {
                "if": {
                  "required": [
                    "route"
                  ]
                },
                "then": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "points"
                        ]
                      },
                      {
                        "required": [
                          "mode"
                        ]
                      },
                      {
                        "required": [
                          "speed"
                        ]
                      },
                      {
                        "required": [
                          "loop"
                        ]
                      },
                      {
                        "required": [
                          "waitTicks"
                        ]
                      }
                    ]
                  }
                },
                "else": {
                  "required": [
                    "points"
                  ]
                }
              }
            }
          ]
        },
        "animus:mount": {
          "type": "object",
          "description": "Rides another NPC.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "vehicle": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
              "description": "The vehicle NPC's id."
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": false
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "else": {
                "required": [
                  "vehicle"
                ]
              }
            }
          ]
        },
        "animus:riding": {
          "type": "object",
          "description": "Lets a real player ride this NPC.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "reviewAccepted": {
              "type": "boolean"
            },
            "permission": {
              "type": "string"
            },
            "speed": {
              "type": "number"
            },
            "leash": {
              "type": "number"
            },
            "lifetimeSeconds": {
              "type": "number"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "then": {
                "properties": {
                  "permission": {
                    "type": "string",
                    "pattern": "^[a-z0-9_-]+(\\.[a-z0-9_-]+)*$",
                    "maxLength": 128
                  },
                  "speed": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 8.0
                  },
                  "leash": {
                    "type": "number",
                    "minimum": 4.0,
                    "maximum": 256.0
                  },
                  "lifetimeSeconds": {
                    "type": "integer",
                    "minimum": 30,
                    "maximum": 3600
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "migration"
        ]
      },
      "then": {
        "properties": {
          "modules": {
            "properties": {
              "animus:navigation": {
                "if": {
                  "properties": {
                    "enabled": {
                      "const": true
                    }
                  },
                  "required": [
                    "enabled"
                  ]
                },
                "then": {
                  "required": [
                    "reviewAccepted"
                  ],
                  "properties": {
                    "reviewAccepted": {
                      "const": true
                    }
                  }
                }
              },
              "animus:riding": {
                "if": {
                  "properties": {
                    "enabled": {
                      "const": true
                    }
                  },
                  "required": [
                    "enabled"
                  ]
                },
                "then": {
                  "required": [
                    "reviewAccepted"
                  ],
                  "properties": {
                    "reviewAccepted": {
                      "const": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
