{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Animus reusable route",
  "description": "routes/<id>.json: points NPCs follow when their animus:navigation names this route. Unknown fields are kept as written.",
  "type": "object",
  "required": [
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "mode": {
      "enum": [
        "walk",
        "swim",
        "fly"
      ],
      "description": "walk by default. Walking points stand on whole-block heights."
    },
    "speed": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Blocks per second. 2 by default."
    },
    "order": {
      "enum": [
        "sequence",
        "pingpong",
        "random",
        "wander"
      ],
      "description": "How the next point is chosen. sequence by default."
    },
    "loop": {
      "type": "boolean",
      "description": "Order sequence only: start again from the first point."
    },
    "waitTicks": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 12000
        },
        {
          "type": "array",
          "description": "[min, max] in ticks, min not above max.",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 12000
          }
        }
      ],
      "description": "Wait before the first leg and after each arrival: ticks, or [min, max] drawn per arrival."
    },
    "seed": {
      "enum": [
        "npc",
        "random"
      ],
      "description": "npc (default): choices stable per NPC and route, across restarts. random: mixed with the clock."
    },
    "startOffset": {
      "enum": [
        "first",
        "random"
      ],
      "description": "random: start at a random point after a random 0..waitTicks wait. first by default."
    },
    "jitter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8,
      "description": "Leg goals move by a random whole-block x/z offset within this radius."
    },
    "points": {
      "type": "array",
      "description": "Route points in the NPC's world, or recording steps; wander centres for order wander.",
      "minItems": 0,
      "maxItems": 256,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "x",
              "y",
              "z"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": -29999984,
                "maximum": 29999984
              },
              "y": {
                "type": "number",
                "minimum": -29999984,
                "maximum": 29999984
              },
              "z": {
                "type": "number",
                "minimum": -29999984,
                "maximum": 29999984
              },
              "waitTicks": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 12000
                  },
                  {
                    "type": "array",
                    "description": "[min, max] in ticks, min not above max.",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 12000
                    }
                  }
                ],
                "description": "Wait after arriving here, instead of the route's."
              },
              "jitter": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8,
                "description": "Jitter radius of this point, instead of the route's."
              },
              "weight": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000,
                "description": "Order random only: how often this point is chosen."
              },
              "next": {
                "type": "array",
                "description": "Order sequence only: after this point, the next point is drawn from these by weight.",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "to"
                  ],
                  "properties": {
                    "to": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 255
                    },
                    "weight": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000
                    }
                  }
                }
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "recording"
                  ]
                },
                {
                  "required": [
                    "fromTick"
                  ]
                },
                {
                  "required": [
                    "toTick"
                  ]
                },
                {
                  "required": [
                    "playback"
                  ]
                }
              ]
            }
          },
          {
            "type": "object",
            "description": "A recording step: walk to the segment's first frame, play it once, then go on from its last frame.",
            "required": [
              "recording"
            ],
            "properties": {
              "recording": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
                "maxLength": 64,
                "description": "A recording under recordings/."
              },
              "fromTick": {
                "type": "integer",
                "minimum": 0,
                "maximum": 72000,
                "description": "First tick of the segment, 0 by default; below toTick."
              },
              "toTick": {
                "type": "integer",
                "minimum": 1,
                "maximum": 72000,
                "description": "Last tick of the segment; the recording's durationTicks by default."
              },
              "playback": {
                "const": "once",
                "description": "A step plays once; loop and pingpong are refused because the route must go on."
              },
              "waitTicks": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 12000
                  },
                  {
                    "type": "array",
                    "description": "[min, max] in ticks, min not above max.",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 12000
                    }
                  }
                ],
                "description": "Wait after arriving here, instead of the route's."
              },
              "weight": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000,
                "description": "Order random only: how often this point is chosen."
              },
              "next": {
                "type": "array",
                "description": "Order sequence only: after this point, the next point is drawn from these by weight.",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "to"
                  ],
                  "properties": {
                    "to": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 255
                    },
                    "weight": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000
                    }
                  }
                }
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "x"
                  ]
                },
                {
                  "required": [
                    "y"
                  ]
                },
                {
                  "required": [
                    "z"
                  ]
                },
                {
                  "required": [
                    "jitter"
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "guides": {
      "type": "array",
      "description": "Order random only: helper nodes a path may pass through.",
      "minItems": 0,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "required": [
          "x",
          "y",
          "z"
        ],
        "properties": {
          "x": {
            "type": "number",
            "minimum": -29999984,
            "maximum": 29999984
          },
          "y": {
            "type": "number",
            "minimum": -29999984,
            "maximum": 29999984
          },
          "z": {
            "type": "number",
            "minimum": -29999984,
            "maximum": 29999984
          }
        }
      }
    },
    "linkDistance": {
      "type": "number",
      "minimum": 1.0,
      "maximum": 256.0,
      "description": "Order random only: the longest link between two nodes."
    },
    "wander": {
      "type": "object",
      "additionalProperties": false,
      "description": "Order wander only.",
      "properties": {
        "radius": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "description": "Blocks from a centre."
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8,
          "description": "Blocks up or down from a centre."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "order": {
            "const": "wander"
          }
        },
        "required": [
          "order"
        ]
      },
      "then": {
        "properties": {
          "points": {
            "maxItems": 64
          }
        }
      },
      "else": {
        "required": [
          "points"
        ],
        "properties": {
          "points": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "loop"
        ]
      },
      "then": {
        "properties": {
          "order": {
            "const": "sequence"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "guides"
        ]
      },
      "then": {
        "properties": {
          "order": {
            "const": "random"
          }
        },
        "required": [
          "order"
        ]
      }
    },
    {
      "if": {
        "required": [
          "linkDistance"
        ]
      },
      "then": {
        "properties": {
          "order": {
            "const": "random"
          }
        },
        "required": [
          "order"
        ]
      }
    },
    {
      "if": {
        "required": [
          "wander"
        ]
      },
      "then": {
        "properties": {
          "order": {
            "const": "wander"
          }
        },
        "required": [
          "order"
        ]
      }
    },
    {
      "if": {
        "not": {
          "properties": {
            "order": {
              "const": "random"
            }
          },
          "required": [
            "order"
          ]
        }
      },
      "then": {
        "properties": {
          "points": {
            "items": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "weight"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "order"
        ],
        "not": {
          "properties": {
            "order": {
              "const": "sequence"
            }
          }
        }
      },
      "then": {
        "properties": {
          "points": {
            "items": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "next"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "order": {
            "const": "wander"
          }
        },
        "required": [
          "order"
        ]
      },
      "then": {
        "properties": {
          "points": {
            "items": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "recording"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "order": {
            "const": "wander"
          }
        },
        "required": [
          "order"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "jitter"
              ]
            }
          ]
        }
      }
    },
    {
      "not": {
        "required": [
          "route"
        ]
      }
    }
  ]
}
