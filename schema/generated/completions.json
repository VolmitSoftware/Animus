    {
      "id": "animus:advance-quest-state",
      "kind": "action",
      "description": "Advances a quest stage, by one unless by says otherwise, without passing maximum.",
      "privileged": false,
      "available": true,
      "reason": "available",
      "arguments": {
        "name": {
          "type": "string",
          "required": true,
          "minLength": 1,
          "maxLength": 64
        },
        "scope": {
          "type": "string",
          "required": false,
          "enum": [
            "global",
            "npc",
            "player",
            "relationship"
          ]
        },
        "by": {
          "type": "integer",
          "required": false,
          "minimum": 1,
          "maximum": 1000000
        },
        "maximum": {
          "type": "integer",
          "required": false,
          "minimum": 0,
          "maximum": 1000000000000
        }
      }
    },
