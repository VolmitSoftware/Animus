{
  "schemaVersion": 1,
  "id": "${projectId}",
  "version": "${projectVersion}",
  "name": "${projectName}",
  "description": "NPCs that act alive instead of being fake players.",
  "authors": ["Volmit Software"],
  "license": "GPL-3.0",
  "environment": "*",
  "entrypoints": {
    "main": ["${projectGroup}.fabric.AnimusFabric"]
  },
  "jars": [
    {"file": "META-INF/jars/fabric-api-base.jar"},
    {"file": "META-INF/jars/fabric-lifecycle-events-v1.jar"},
    {"file": "META-INF/jars/fabric-command-api-v2.jar"}
  ],
  "depends": {
    "fabricloader": ">=${fabricLoaderVersion}",
    "minecraft": "${minecraftVersion}",
    "java": ">=${javaVersion}"
  }
